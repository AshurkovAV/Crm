<?xml version="1.0" encoding="utf-8"?>
<!--
  Используется только при размещении в IIS (при публикации SDK дописывает сюда секцию aspNetCore).
  Лимит тела запроса поднят до 52 МБ, чтобы проходили вложения базы знаний до 50 МБ
  (по умолчанию IIS режет запросы больше ~28.6 МБ).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="54525952" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
