@model WikiPageViewModel
@{
    var p = Model.Page;
    ViewData["Title"] = p.Title + " — База знаний";
    var canAddChild = Model.CanEdit && Model.Depth < WikiAccess.MaxDepth;
}
@section Styles {
    <link rel="stylesheet" href="~/css/wiki.css" asp-append-version="true" />
}

<div class="wk" data-wiki-root>
    <partial name="_WikiHead" model="Model" />

    <div class="wk-layout">
        <partial name="_WikiSide" model="Model.Tree" />

        <article class="wk-card wk-article" data-wiki-page="@p.Id" data-can-edit="@(Model.CanEdit ? "true" : "false")"
                 data-section-id="@p.SectionId" data-parent-id="@p.ParentId" data-title="@p.Title">
            <nav class="wk-crumbs" aria-label="Навигация">
                @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
                {
                    var c = Model.Breadcrumbs[i];
                    if (i > 0) { <i class="fa-solid fa-chevron-right" aria-hidden="true"></i> }
                    <a href="@c.Url">@c.Title</a>
                }
            </nav>

            <div class="wk-page-head">
                <h1 class="wk-page-title">@p.Title</h1>
                <div class="wk-page-actions">
                    <button type="button" class="wk-icon-btn @(Model.IsFavorite ? "is-on" : null)" data-wiki-favorite aria-pressed="@(Model.IsFavorite ? "true" : "false")"
                            title="@(Model.IsFavorite ? "Убрать из избранного" : "В избранное")" aria-label="Избранное">
                        <i class="@(Model.IsFavorite ? "fa-solid" : "fa-regular") fa-star"></i>
                    </button>
                    @if (Model.CanEdit)
                    {
                        <a class="wk-btn wk-btn-pri" href="/Wiki/Edit/@p.Id"><i class="fa-solid fa-pen"></i>Редактировать</a>
                    }
                    <div class="wk-menu-wrap">
                        <button type="button" class="wk-icon-btn" data-menu-toggle aria-haspopup="true" aria-expanded="false" aria-label="Ещё действия"><i class="fa-solid fa-ellipsis"></i></button>
                        <div class="wk-menu" hidden role="menu">
                            <a role="menuitem" href="/Wiki/History/@p.Id"><i class="fa-solid fa-clock-rotate-left"></i>История изменений</a>
                            <a role="menuitem" href="/Tasks?wikiPage=@p.Id"><i class="fa-solid fa-list-check"></i>Создать задачу по странице</a>
                            <button type="button" role="menuitem" data-wiki-print><i class="fa-solid fa-print"></i>Печать / сохранить PDF</button>
                            <button type="button" role="menuitem" data-wiki-copy-link><i class="fa-solid fa-link"></i>Скопировать ссылку</button>
                            @if (Model.CanEdit)
                            {
                                <hr />
                                @if (canAddChild)
                                {
                                    <button type="button" role="menuitem" data-wiki-new-page data-section-id="@p.SectionId" data-parent-id="@p.Id" data-parent-title="@p.Title"><i class="fa-solid fa-plus"></i>Добавить подстраницу</button>
                                }
                                <button type="button" role="menuitem" data-wiki-pin="@(p.IsPinned ? "false" : "true")"><i class="fa-solid fa-thumbtack"></i>@(p.IsPinned ? "Открепить из «Начните отсюда»" : "Закрепить в «Начните отсюда»")</button>
                                <button type="button" role="menuitem" data-wiki-shift="-1"><i class="fa-solid fa-arrow-up"></i>Переместить выше</button>
                                <button type="button" role="menuitem" data-wiki-shift="1"><i class="fa-solid fa-arrow-down"></i>Переместить ниже</button>
                                <button type="button" role="menuitem" data-wiki-move><i class="fa-solid fa-turn-up fa-rotate-90"></i>Переместить в…</button>
                                <button type="button" role="menuitem" data-wiki-review-settings><i class="fa-regular fa-calendar-check"></i>Ответственный и срок проверки</button>
                                <hr />
                                <button type="button" role="menuitem" class="is-danger" data-wiki-delete-page><i class="fa-solid fa-trash"></i>Удалить страницу</button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="wk-page-meta">
                <span><i class="fa-regular fa-pen-to-square"></i>Обновлено @WikiFormat.Date(p.ModifiedDate)@(Model.ModifiedByName != null ? ", " + Model.ModifiedByName : "")</span>
                <span><a href="/Wiki/History/@p.Id" style="text-decoration:none"><i class="fa-solid fa-code-branch"></i> Версия @p.Version</a></span>
                @if (Model.OwnerName != null)
                {
                    <span><i class="fa-regular fa-user"></i>Ответственный: @Model.OwnerName</span>
                }
                @if (p.ReviewDueDate.HasValue)
                {
                    <span class="wk-chip @(Model.IsStale ? "wk-chip-stale" : "wk-chip-ok")"><i class="fa-regular fa-calendar-check"></i>Проверить до @WikiFormat.Day(p.ReviewDueDate.Value)</span>
                }
                @if (p.IsPinned)
                {
                    <span class="wk-chip wk-chip-acc"><i class="fa-solid fa-thumbtack"></i>Начните отсюда</span>
                }
            </div>

            @if (Model.IsStale)
            {
                <div class="wk-banner" role="status">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>Срок проверки истёк @WikiFormat.Day(p.ReviewDueDate!.Value). Информация на странице может быть устаревшей.</span>
                    @if (Model.CanConfirmReview)
                    {
                        <button type="button" class="wk-btn wk-btn-sm" data-wiki-reviewed><i class="fa-solid fa-check"></i>Проверено, всё актуально</button>
                    }
                </div>
            }

            <hr class="wk-divider" />

            <div class="wk-prose" data-wiki-content>
                @if (string.IsNullOrWhiteSpace(p.ContentHtml))
                {
                    <p class="wk-faint">Страница пока пустая.@if (Model.CanEdit) { <text> <a href="/Wiki/Edit/@p.Id">Заполнить</a></text> }</p>
                }
                else
                {
                    @Html.Raw(WikiHtml.Sanitize(p.ContentHtml))
                }
            </div>

            @if (Model.Children.Count > 0)
            {
                <section class="wk-block wk-noprint">
                    <div class="wk-block-head"><h2>Подстраницы</h2></div>
                    <div class="wk-children">
                        @foreach (var c in Model.Children)
                        {
                            <a class="wk-child" href="/Wiki/Page/@c.Id"><i class="fa-regular fa-file-lines"></i><span>@c.Title</span></a>
                        }
                    </div>
                </section>
            }

            <section class="wk-block wk-noprint" data-wiki-attachments>
                <div class="wk-block-head">
                    <h2>Файлы <span class="wk-chip" data-attachments-count hidden></span></h2>
                </div>
                @if (Model.CanEdit)
                {
                    <div class="wk-drop" data-wiki-drop tabindex="0" role="button" aria-label="Загрузить файлы">
                        <i class="fa-solid fa-cloud-arrow-up" style="font-size:20px;color:var(--ui-acc)"></i>
                        <div>Перетащите файлы сюда или <b>выберите на компьютере</b></div>
                        <small>До 50 МБ каждый. Картинки и PDF можно смотреть прямо в браузере.</small>
                        <input type="file" multiple hidden data-wiki-file-input />
                    </div>
                    <div class="wk-uploads" data-wiki-uploads></div>
                }
                <div class="wk-files" data-wiki-files><div class="wk-empty-mini">Загрузка…</div></div>
            </section>

            <section class="wk-block wk-noprint" data-wiki-tasks>
                <div class="wk-block-head">
                    <h2>Связанные задачи</h2>
                    <a class="wk-btn wk-btn-sm" href="/Tasks?wikiPage=@p.Id"><i class="fa-solid fa-plus"></i>Создать задачу по странице</a>
                </div>
                <div class="wk-tasks" data-wiki-task-list><div class="wk-empty-mini">Загрузка…</div></div>
            </section>
        </article>
    </div>

    @if (Model.CanEdit)
    {
        <dialog class="wk-dialog" id="wkReviewDialog" aria-labelledby="wkReviewTitle">
            <form method="dialog" data-wiki-review-form>
                <div class="wk-dialog-head">
                    <h2 id="wkReviewTitle">Актуальность страницы</h2>
                    <button type="button" class="wk-icon-btn" data-dialog-close aria-label="Закрыть"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="wk-dialog-body">
                    <label class="wk-field">
                        <span>Ответственный за страницу</span>
                        <select class="wk-select" name="ownerUserId" data-selected="@p.OwnerUserId"><option value="">— не назначен —</option></select>
                    </label>
                    <label class="wk-field">
                        <span>Проверить до</span>
                        <input class="wk-input" type="date" name="reviewDueDate" value="@(p.ReviewDueDate?.ToString("yyyy-MM-dd"))" />
                        <small>После этой даты страница попадёт в список «Требуют проверки», а читатели увидят предупреждение.</small>
                    </label>
                </div>
                <div class="wk-dialog-foot">
                    <button type="button" class="wk-btn" data-dialog-close>Отмена</button>
                    <button type="submit" class="wk-btn wk-btn-pri">Сохранить</button>
                </div>
            </form>
        </dialog>

        <dialog class="wk-dialog" id="wkMoveDialog" aria-labelledby="wkMoveTitle">
            <form method="dialog" data-wiki-move-form>
                <div class="wk-dialog-head">
                    <h2 id="wkMoveTitle">Переместить страницу</h2>
                    <button type="button" class="wk-icon-btn" data-dialog-close aria-label="Закрыть"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="wk-dialog-body">
                    <label class="wk-field">
                        <span>Новое место</span>
                        <select class="wk-select" name="parentId">
                            <option value="">В корень раздела «@Model.Section.Name»</option>
                            @foreach (var item in Model.Tree.Items.Where(i => i.Id != p.Id))
                            {
                                var depth = Model.Tree.Depth(item.Id);
                                if (depth >= WikiAccess.MaxDepth) { continue; }
                                <option value="@item.Id" selected="@(item.Id == p.ParentId)">@(new string(' ', (depth - 1) * 3))@item.Title</option>
                            }
                        </select>
                        <small>Также можно перетаскивать страницы мышью в дереве слева.</small>
                    </label>
                </div>
                <div class="wk-dialog-foot">
                    <button type="button" class="wk-btn" data-dialog-close>Отмена</button>
                    <button type="submit" class="wk-btn wk-btn-pri">Переместить</button>
                </div>
            </form>
        </dialog>
    }

    <partial name="_WikiDialogs" model="Model" />
</div>

@section Scripts {
    <script src="~/js/wiki/wiki.js" asp-append-version="true"></script>
}
