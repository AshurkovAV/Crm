@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вход в CRM систему</title>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Open Sans', sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #2c539e 0%, #5f7dc6 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            color: #fff;
        }
        
        .container {
            width: 100%;
            max-width: 420px;
            text-align: center;
        }
        
        .logo {
            margin-bottom: 30px;
        }
        
        .logo h1 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        
        .logo p {
            font-size: 16px;
            opacity: 0.8;
        }
        
        .auth-box {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            color: #333;
        }
        
        .auth-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 25px;
            color: #2c539e;
        }
        
        .input-group {
            margin-bottom: 20px;
            text-align: left;
        }
        
        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: #555;
        }
        
        .input-group input {
            width: 100%;
            padding: 14px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
            transition: border-color 0.3s;
        }
        
        .input-group input:focus {
            border-color: #2c539e;
            outline: none;
        }
        
        .login-btn {
            width: 100%;
            padding: 14px;
            background: #2c539e;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s;
            margin-bottom: 20px;
        }
        
        .login-btn:hover {
            background: #3a63b0;
        }
        
        .divider {
            display: flex;
            align-items: center;
            margin: 20px 0;
        }
        
        .divider::before, .divider::after {
            content: "";
            flex: 1;
            border-bottom: 1px solid #ddd;
        }
        
        .divider span {
            padding: 0 15px;
            color: #777;
            font-size: 14px;
        }
        
        .social-login {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .social-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #f5f5f5;
            border: 1px solid #ddd;
            cursor: pointer;
            transition: background 0.3s;
        }
        
        .social-btn:hover {
            background: #e9e9e9;
        }
        
        .transparent-btn {
            background: transparent;
            border: 2px solid #2c539e;
            color: #2c539e;
            padding: 12px 20px;
            border-radius: 5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            margin: 10px 0;
            width: 100%;
            font-size: 15px;
        }
        
        .transparent-btn:hover {
            background: #2c539e;
            color: white;
        }
        
        .footer-links {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
            font-size: 14px;
        }
        
        .footer-links a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .footer-links a:hover {
            color: white;
            text-decoration: underline;
        }
        
        .create-account {
            position: absolute;
            top: 20px;
            right: 20px;
            color: white;
            text-decoration: none;
            font-weight: 600;
            padding: 8px 15px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 5px;
            transition: all 0.3s;
        }
        
        .create-account:hover {
            background: rgba(255, 255, 255, 0.1);
        }
        
        .policy-link {
            position: absolute;
            bottom: 20px;
            left: 20px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            font-size: 14px;
        }
        
        .policy-link:hover {
            color: white;
            text-decoration: underline;
        }
        
        @@media (max-width: 768px) {
            .create-account, .policy-link {
                position: relative;
                display: inline-block;
                margin: 10px;
                top: auto;
                bottom: auto;
                left: auto;
                right: auto;
            }
            
            .footer-links {
                flex-direction: column;
                align-items: center;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <a href="#" class="create-account">Создать кабинет CRM</a>
    
    <div class="container">
        <div class="logo">
            <h1>Crm.System®</h1>
            <p>Помогает бизнесу работать</p>
        </div>
        
        <div class="auth-box">
            <h2 class="auth-title">Войти в CRM</h2>
            
            <div class="input-group">
                <label for="email">E-mail или телефон</label>
                <input type="text" id="email" placeholder="name@company.ru">
            </div>
            
            <button class="login-btn">Войти</button>
            
            <div class="divider">
                <span>или</span>
            </div>
            
            <div class="social-login">
                <div class="social-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#2c539e">
                        <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/>
                    </svg>
                </div>
                <div class="social-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#2c539e">
                        <path d="M12 2.04c-5.5 0-10 4.49-10 10.02 0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02z"/>
                    </svg>
                </div>
                <div class="social-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#2c539e">
                        <path d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.35 0 9.25-3.67 9.25-9.09 0-1.15-.15-1.81-.15-1.81z"/>
                    </svg>
                </div>
            </div>
            
            <button class="transparent-btn">Вход без логина и пароля</button>
            <button class="transparent-btn">Войти с помощью SMS</button>
        </div>
        
        <div class="footer-links">
            <a href="#">Политика конфиденциальности</a>
            <a href="#">Техническая поддержка</a>
            <a href="#">Условия использования</a>
        </div>
    </div>
    
    <a href="#" class="policy-link">Политика обработки персональных данных</a>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loginBtn = document.querySelector('.login-btn');
            
            loginBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const email = document.getElementById('email').value;
                
                if (!email) {
                    alert('Пожалуйста, введите email или телефон');
                    return;
                }
                
                // Здесь будет код для обработки входа
                alert('Вход выполняется для: ' + email);
            });
            
            // Добавляем обработчики для прозрачных кнопок
            const transparentBtns = document.querySelectorAll('.transparent-btn');
            transparentBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    alert('Альтернативный метод входа: ' + this.textContent);
                });
            });
        });
    </script>
</body>
</html>
