@model Crm.Models.Home.HomeIndexViewModel
@using Crm.Models.Home
@{
    ViewData["Title"] = "Главная";
    var m = Model ?? new HomeIndexViewModel
    {
        HasOwnCompany = ViewBag.HasOwnCompany ?? false,
        HasAnyCompany = ViewBag.HasAnyCompany ?? false
    };
    var d = m.Data;
    var now = m.Now;
    var today = now.Date;

    void RenderTasksCard()
    {
        <section class="hm-card hm-panel hm-o-tasks">
            <div class="hm-panel-head">
                <h2>Мои задачи</h2>
                <a class="hm-link" href="/Tasks">Все · @d.MyOpenTasks <i class="fa-solid fa-chevron-right"></i></a>
            </div>
            @if (d.MyTasks.Count == 0)
            {
                <div class="hm-empty">
                    <i class="fa-solid fa-mug-hot"></i>
                    <p>Открытых задач нет — можно взять новую</p>
                    <a class="hm-btn hm-btn-sm" href="/Tasks">Перейти к задачам</a>
                </div>
            }
            else
            {
                <ul class="hm-tasks">
                    @foreach (var t in d.MyTasks)
                    {
                        var late = t.Deadline.HasValue && t.Deadline.Value < now;
                        var inProgress = t.StatusName != null && t.StatusName.StartsWith("В работе", StringComparison.OrdinalIgnoreCase);
                        var important = string.Equals(t.Priority, "Высокий", StringComparison.OrdinalIgnoreCase);
                        <li>
                            <a href="/Tasks">
                                <span class="hm-task-dot @(late ? "is-late" : inProgress ? "is-prog" : null)"></span>
                                <span class="hm-task-body">
                                    <span class="hm-task-name">@t.Name</span>
                                    <span class="hm-task-meta">
                                        @if (t.Deadline.HasValue)
                                        {
                                            var dl = t.Deadline.Value;
                                            var label = dl.Date == today ? "сегодня" : dl.Date == today.AddDays(1) ? "завтра" : HomeIndexViewModel.ShortDate(dl, now);
                                            <span class="hm-nowrap @(late ? "hm-bad" : null)"><i class="@(late ? "fa-solid fa-triangle-exclamation" : "fa-regular fa-calendar")"></i> @label</span>
                                        }
                                        else
                                        {
                                            <span class="hm-nowrap"><i class="fa-regular fa-calendar"></i> без срока</span>
                                        }
                                        @if (!string.IsNullOrEmpty(t.ProjectName))
                                        {
                                            <span class="hm-chip hm-chip-gray">@t.ProjectName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(t.StatusName))
                                        {
                                            <span class="hm-chip hm-chip-acc">@t.StatusName</span>
                                        }
                                        @if (important)
                                        {
                                            <span class="hm-chip hm-chip-crit">Важно</span>
                                        }
                                    </span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>
    }
}

<div class="hm">
    @if (!m.HasAnyCompany)
    {
        <section class="hm-onb">
            <div class="hm-onb-head">
                <span class="hm-onb-logo"><i class="fa-solid fa-layer-group"></i></span>
                <h1>Добро пожаловать в CRM</h1>
                <p>Чтобы начать работу, создайте свою компанию или присоединитесь к существующей по коду приглашения.</p>
            </div>
            <div class="hm-onb-grid">
                <div class="hm-card hm-onb-card" id="createCompanyCard">
                    <span class="hm-onb-ic"><i class="fa-solid fa-building"></i></span>
                    <h3>Создать компанию</h3>
                    <p>Станьте владельцем компании, ведите задачи и проекты, приглашайте сотрудников.</p>
                    <button type="button" class="hm-btn hm-btn-pri" id="createCompanyBtn"><i class="fa-solid fa-plus"></i> Создать компанию</button>
                </div>
                <div class="hm-card hm-onb-card" id="joinCompanyCard">
                    <span class="hm-onb-ic hm-onb-ic-alt"><i class="fa-solid fa-link"></i></span>
                    <h3>Присоединиться к компании</h3>
                    <p>У вас есть код приглашения? Введите его, чтобы стать участником компании.</p>
                    <button type="button" class="hm-btn" id="joinCompanyBtn"><i class="fa-solid fa-key"></i> Ввести код</button>
                </div>
            </div>
        </section>
    }
    else
    {
        <header class="hm-head">
            <div class="hm-head-text">
                <h1>Добрый день, @m.GreetingName</h1>
                <p>@m.Summary</p>
            </div>
            <div class="hm-head-actions">
                <a class="hm-btn" href="/Tasks"><i class="fa-solid fa-list-check"></i> Задачи</a>
                @if (m.IsFull)
                {
                    <a class="hm-btn hm-btn-pri" href="/Deals"><i class="fa-solid fa-handshake"></i> Сделки</a>
                }
                else
                {
                    <a class="hm-btn hm-btn-pri" href="/Project"><i class="fa-solid fa-folder"></i> Проекты</a>
                }
            </div>
        </header>

        @* ---------- KPI ---------- *@
        <section class="hm-kpis">
            @if (m.IsFull && d.SalesLoaded)
            {
                <a class="hm-kpi hm-kpi-dark" href="/Deals">
                    <div class="hm-kpi-top"><span>Сделки в работе</span><i class="fa-solid fa-briefcase"></i></div>
                    <div class="hm-kpi-val">@d.OpenDeals</div>
                    <div class="hm-kpi-sub">на сумму <b>@HomeIndexViewModel.Rub(d.OpenDealsAmount)</b></div>
                </a>
                if (d.HasProduction)
                {
                    <a class="hm-kpi" href="/Workflows">
                        <div class="hm-kpi-top"><span>Заказы в производстве</span><i class="fa-solid fa-industry"></i></div>
                        <div class="hm-kpi-val">@d.OrdersInProduction</div>
                        @if (d.OrdersInProductionOverdue > 0)
                        {
                            <div class="hm-kpi-sub hm-bad"><i class="fa-solid fa-triangle-exclamation"></i> @d.OrdersInProductionOverdue с истёкшим сроком</div>
                        }
                        else
                        {
                            <div class="hm-kpi-sub">сроки не нарушены</div>
                        }
                    </a>
                }
            }
            <a class="hm-kpi" href="/Tasks">
                <div class="hm-kpi-top"><span>Мои задачи в работе</span><i class="fa-solid fa-list-check"></i></div>
                <div class="hm-kpi-val">@d.MyOpenTasks</div>
                <div class="hm-kpi-sub">назначены на меня</div>
            </a>
            <a class="hm-kpi" href="/Tasks">
                <div class="hm-kpi-top"><span>Просрочено</span><i class="fa-regular fa-clock"></i></div>
                <div class="hm-kpi-val @(d.MyOverdueTasks > 0 ? "hm-bad" : null)">@d.MyOverdueTasks</div>
                <div class="hm-kpi-sub">@(d.MyOverdueTasks > 0 ? "срок уже прошёл" : "всё в срок")</div>
            </a>
            @if (!m.IsFull)
            {
                <a class="hm-kpi" href="/Tasks">
                    <div class="hm-kpi-top"><span>Выполнено за 7 дней</span><i class="fa-solid fa-circle-check"></i></div>
                    <div class="hm-kpi-val">@d.MyDoneLast7Days</div>
                    <div class="hm-kpi-sub">моих задач</div>
                </a>
            }
            @if (!m.IsFull || !d.SalesLoaded || !d.HasProduction)
            {
                <a class="hm-kpi" href="/Project">
                    <div class="hm-kpi-top"><span>Активных проектов</span><i class="fa-solid fa-folder-open"></i></div>
                    <div class="hm-kpi-val">@d.ActiveProjects</div>
                    <div class="hm-kpi-sub">где я участник</div>
                </a>
            }
        </section>

        <div class="hm-grid">
            <div class="hm-col">
                @if (m.IsFull && d.SalesLoaded)
                {
                    var maxCount = d.DealStages.Count == 0 ? 1 : d.DealStages.Max(s => s.Count);
                    <section class="hm-card hm-panel hm-o-deals">
                        <div class="hm-panel-head">
                            <h2>Сделки по этапам</h2>
                            <a class="hm-link" href="/Deals">Все сделки <i class="fa-solid fa-chevron-right"></i></a>
                        </div>
                        @if (d.DealStages.Count == 0)
                        {
                            <div class="hm-empty">
                                <i class="fa-solid fa-handshake"></i>
                                <p>Сделок пока нет</p>
                                <a class="hm-btn hm-btn-sm" href="/Deals">Создать сделку</a>
                            </div>
                        }
                        else
                        {
                            <ul class="hm-stages">
                                @foreach (var s in d.DealStages)
                                {
                                    var w = Math.Max(4, (int)Math.Round(100.0 * s.Count / Math.Max(1, maxCount)));
                                    <li class="@(s.IsClosed ? "is-closed" : null)">
                                        <span class="hm-stage-name">@s.Status</span>
                                        <span class="hm-bar"><i style="width:@(w)%"></i></span>
                                        <span class="hm-stage-cnt">@s.Count</span>
                                        <span class="hm-stage-sum">@HomeIndexViewModel.RubShort(s.Amount)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </section>

                    if (d.HasProduction)
                    {
                        <section class="hm-card hm-panel hm-o-prod">
                            <div class="hm-panel-head">
                                <h2>В производстве</h2>
                                <a class="hm-link" href="/Workflows">Все заказы · @d.OrdersInProduction <i class="fa-solid fa-chevron-right"></i></a>
                            </div>
                            @if (d.Production.Count == 0)
                            {
                                <div class="hm-empty"><i class="fa-solid fa-industry"></i><p>Все заказы завершены</p></div>
                            }
                            else
                            {
                                <ul class="hm-prod">
                                    @foreach (var p in d.Production)
                                    {
                                        var pct = p.TotalStages == 0 ? 0 : (int)Math.Round(100.0 * p.DoneStages / p.TotalStages);
                                        var late = p.DueDate.HasValue && p.DueDate.Value.Date < today;
                                        var sub = p.ClientName ?? p.DealTitle;
                                        if (!string.IsNullOrEmpty(p.CurrentStage))
                                        {
                                            sub = string.IsNullOrEmpty(sub) ? p.CurrentStage : sub + " · " + p.CurrentStage;
                                        }
                                        <li>
                                            <div class="hm-prod-row">
                                                <span class="hm-prod-name">@p.Name</span>
                                                <span class="hm-prod-pct">@pct%</span>
                                            </div>
                                            <span class="hm-bar"><i style="width:@(pct)%"></i></span>
                                            <div class="hm-prod-row hm-meta">
                                                <span class="hm-ellipsis">@sub</span>
                                                @if (p.DueDate.HasValue)
                                                {
                                                    <span class="hm-nowrap @(late ? "hm-bad" : null)">@if (late)
                                                        {
                                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                                        } до @HomeIndexViewModel.ShortDate(p.DueDate.Value, now)</span>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                }

                @if (!m.IsFull)
                {
                    RenderTasksCard();
                }

                <section class="hm-card hm-panel hm-o-proj">
                    <div class="hm-panel-head">
                        <h2>Проекты</h2>
                        <a class="hm-link" href="/Project">Все · @d.ActiveProjects <i class="fa-solid fa-chevron-right"></i></a>
                    </div>
                    @if (d.Projects.Count == 0)
                    {
                        <div class="hm-empty">
                            <i class="fa-solid fa-folder-open"></i>
                            <p>Активных проектов нет</p>
                            <a class="hm-btn hm-btn-sm" href="/Project">Перейти к проектам</a>
                        </div>
                    }
                    else
                    {
                        <ul class="hm-projects">
                            @foreach (var p in d.Projects)
                            {
                                var pct = p.TotalTasks == 0 ? 0 : (int)Math.Round(100.0 * p.DoneTasks / p.TotalTasks);
                                var members = $"{p.Members} {HomeIndexViewModel.Plural(p.Members, "участник", "участника", "участников")}";
                                <li>
                                    <a href="/Project">
                                        <span class="hm-proj-ic"><i class="fa-solid fa-folder"></i></span>
                                        <span class="hm-proj-body">
                                            <span class="hm-prod-row">
                                                <span class="hm-prod-name">@p.Name</span>
                                                @if (!string.IsNullOrEmpty(p.Status))
                                                {
                                                    <span class="hm-chip hm-chip-gray">@p.Status</span>
                                                }
                                            </span>
                                            @if (p.TotalTasks > 0)
                                            {
                                                <span class="hm-bar"><i style="width:@(pct)%"></i></span>
                                                <span class="hm-meta">Выполнено @p.DoneTasks из @p.TotalTasks · @pct% · @members</span>
                                            }
                                            else
                                            {
                                                <span class="hm-meta">Задач пока нет · @members</span>
                                            }
                                        </span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <div class="hm-col">
                @if (m.IsFull)
                {
                    RenderTasksCard();
                }

                <section class="hm-card hm-panel hm-o-team">
                    <div class="hm-panel-head">
                        <h2>Команда</h2>
                        <a class="hm-link" href="/company">@d.TeamCount @HomeIndexViewModel.Plural(d.TeamCount, "сотрудник", "сотрудника", "сотрудников") <i class="fa-solid fa-chevron-right"></i></a>
                    </div>
                    @if (m.Team.Count == 0)
                    {
                        <div class="hm-empty"><i class="fa-solid fa-users"></i><p>Сотрудников пока нет</p></div>
                    }
                    else
                    {
                        <ul class="hm-team">
                            @foreach (var u in m.Team)
                            {
                                <li>
                                    @if (!string.IsNullOrEmpty(u.AvatarUrl))
                                    {
                                        <img class="hm-av" src="@u.AvatarUrl" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="hm-av hm-av-@u.Tone">@u.Initials</span>
                                    }
                                    <span class="hm-team-body">
                                        <b>@u.Name@if (u.IsMe)
                                            {
                                                <em> (вы)</em>
                                            }</b>
                                        @if (!string.IsNullOrWhiteSpace(u.Position))
                                        {
                                            <span class="hm-meta">@u.Position</span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                        @if (d.TeamCount > m.Team.Count)
                        {
                            <a class="hm-more" href="/company">и ещё @(d.TeamCount - m.Team.Count)</a>
                        }
                    }
                    @if (m.HasOwnCompany)
                    {
                        <a class="hm-btn hm-btn-dashed" href="/company"><i class="fa-solid fa-user-plus"></i> Пригласить сотрудника</a>
                    }
                </section>

                <section class="hm-card hm-join hm-o-join">
                    <span class="hm-onb-ic hm-onb-ic-alt"><i class="fa-solid fa-link"></i></span>
                    <div class="hm-join-text">
                        <b>Присоединиться к другой компании</b>
                        <span class="hm-meta">@(m.HasOwnCompany ? "Вас пригласили в другую компанию? Введите код." : "Есть код приглашения? Станьте участником ещё одной компании.")</span>
                    </div>
                    @if (m.HasOwnCompany)
                    {
                        <button type="button" class="hm-btn hm-btn-sm" id="joinCompanyBtnOwn">Ввести код</button>
                    }
                    else
                    {
                        <button type="button" class="hm-btn hm-btn-sm" id="joinCompanyBtnOnly">Ввести код</button>
                    }
                </section>
            </div>
        </div>
    }
</div>

<!-- Модальные окна (обработчики кнопок createCompanyBtn / joinCompanyBtn* — внутри партиалов) -->
@await Html.PartialAsync("/Views/Shared/Company/_InviteModal.cshtml")
@await Html.PartialAsync("/Views/Shared/Company/_CreateCompanyModal.cshtml")

<style>
    .hm {
        --hm-bg: #f4f5f8; --hm-card: #fff; --hm-line: #e4e7ee; --hm-line2: #eef0f4;
        --hm-ink: #0f172a; --hm-ink2: #334155; --hm-muted: #5b6475; --hm-faint: #8a93a6;
        --hm-acc: #4f46e5; --hm-acc-h: #4338ca; --hm-acc-s: #eef0ff; --hm-dark: #0f172a;
        --hm-bad: #b91c1c; --hm-bad-s: #fdecec;
        font-family: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
        color: var(--hm-ink);
        font-size: 14px;
        line-height: 1.4;
        max-width: 1440px;
        margin: 0 auto;
        padding: 28px 32px 40px;
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        font-feature-settings: "tnum" 1;
    }
    .hm *, .hm *::before, .hm *::after { box-sizing: border-box; }
    .hm h1, .hm h2, .hm h3, .hm p, .hm ul { margin: 0; padding: 0; }
    .hm ul { list-style: none; }
    .hm a { color: inherit; text-decoration: none; }

    .hm-card { background: var(--hm-card); border: 1px solid var(--hm-line); border-radius: 20px; min-width: 0; }
    .hm-meta { color: var(--hm-muted); font-size: 12.5px; }
    .hm-bad { color: var(--hm-bad) !important; }
    .hm-nowrap { white-space: nowrap; }
    .hm-ellipsis { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .hm-btn {
        height: 44px; border-radius: 12px; padding: 0 16px; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        font: inherit; font-weight: 700; font-size: 14px; border: 1px solid var(--hm-line); background: #fff; color: var(--hm-ink) !important;
        white-space: nowrap; cursor: pointer; transition: background .15s, border-color .15s;
    }
    .hm-btn:hover { background: #f8f9fc; border-color: #d5d9e3; }
    .hm-btn-pri { background: var(--hm-acc); border-color: var(--hm-acc); color: #fff !important; }
    .hm-btn-pri:hover { background: var(--hm-acc-h); border-color: var(--hm-acc-h); }
    .hm-btn-sm { height: 36px; border-radius: 10px; padding: 0 12px; font-size: 13px; }
    .hm-btn-dashed { width: 100%; margin-top: 16px; border-style: dashed; color: var(--hm-muted) !important; height: 42px; }
    .hm-btn:disabled { opacity: .6; cursor: not-allowed; }

    .hm-chip { display: inline-flex; align-items: center; gap: 4px; height: 22px; padding: 0 8px; border-radius: 999px; font-size: 11.5px; font-weight: 700; white-space: nowrap; flex: none; }
    .hm-chip-gray { background: var(--hm-line2); color: var(--hm-ink2); }
    .hm-chip-acc { background: var(--hm-acc-s); color: var(--hm-acc-h); }
    .hm-chip-crit { background: var(--hm-bad-s); color: var(--hm-bad); }

    .hm-bar { display: block; height: 6px; border-radius: 99px; background: var(--hm-line2); overflow: hidden; }
    .hm-bar > i { display: block; height: 100%; border-radius: 99px; background: var(--hm-acc); }

    /* ---------- Шапка */
    .hm-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 22px; flex-wrap: wrap; }
    .hm-head-text { min-width: 0; }
    .hm-head h1 { font-size: 30px; font-weight: 800; letter-spacing: -.5px; line-height: 1.15; overflow-wrap: anywhere; }
    .hm-head p { color: var(--hm-muted); font-size: 15px; margin-top: 6px; }
    .hm-head-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* ---------- KPI */
    .hm-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
    .hm-kpi {
        background: #fff; border: 1px solid var(--hm-line); border-radius: 20px; padding: 20px 22px; min-width: 0;
        display: flex; flex-direction: column; gap: 6px; transition: border-color .15s, box-shadow .15s;
    }
    .hm-kpi:hover { border-color: #cfd3f7; box-shadow: 0 6px 20px rgba(15, 23, 42, .05); }
    .hm-kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-weight: 700; color: var(--hm-ink2); font-size: 14px; }
    .hm-kpi-top i { width: 36px; height: 36px; border-radius: 10px; background: var(--hm-acc-s); color: var(--hm-acc); display: grid; place-items: center; font-size: 15px; flex: none; }
    .hm-kpi-val { font-size: 34px; font-weight: 800; letter-spacing: -.5px; line-height: 1.1; }
    .hm-kpi-sub { color: var(--hm-muted); font-size: 13px; font-weight: 600; }
    .hm-kpi-sub b { color: var(--hm-ink); font-weight: 800; }
    .hm .hm-kpi-dark { background: var(--hm-dark); border-color: var(--hm-dark); color: #fff; }
    .hm-kpi-dark:hover { border-color: var(--hm-dark); box-shadow: 0 10px 28px rgba(15, 23, 42, .25); }
    .hm-kpi-dark .hm-kpi-top { color: #cbd5e1; }
    .hm-kpi-dark .hm-kpi-top i { background: rgba(255, 255, 255, .1); color: #fff; }
    .hm-kpi-dark .hm-kpi-sub { color: #94a3b8; }
    .hm-kpi-dark .hm-kpi-sub b { color: #fff; }

    /* ---------- Сетка */
    .hm-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 400px); gap: 20px; align-items: start; }
    .hm-col { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
    .hm-panel { padding: 22px 24px; }
    .hm-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
    .hm-panel-head h2 { font-size: 18px; font-weight: 800; letter-spacing: -.2px; }
    .hm-link { color: var(--hm-acc) !important; font-weight: 700; font-size: 13.5px; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }
    .hm-link i { font-size: 10px; }
    .hm-empty { text-align: center; padding: 22px 10px; color: var(--hm-muted); display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .hm-empty > i { font-size: 20px; color: var(--hm-faint); width: 48px; height: 48px; border-radius: 14px; background: var(--hm-line2); display: grid; place-items: center; }

    /* Задачи */
    .hm-tasks li + li { border-top: 1px solid var(--hm-line2); }
    .hm-tasks a { display: flex; gap: 12px; padding: 12px 0; align-items: flex-start; }
    .hm-tasks a:hover .hm-task-name { color: var(--hm-acc); }
    .hm-task-dot { width: 20px; height: 20px; border-radius: 6px; border: 1.5px solid #c9ceda; flex: none; margin-top: 1px; }
