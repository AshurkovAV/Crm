@{
    ViewData["Title"] = "Главная";
    bool hasOwnCompany = ViewBag.HasOwnCompany ?? false;
    bool hasAnyCompany = ViewBag.HasAnyCompany ?? false;
}

<div class="content-section">
    @if (!hasAnyCompany)
    {
        <div class="welcome-message">
            <h2>Добро пожаловать в CRM-систему!</h2>
            <p>Чтобы начать работу, выберите один из вариантов:</p>
        </div>

        <div class="company-actions">
            <div class="action-card" id="createCompanyCard">
                <div class="action-icon">🏢</div>
                <h3>Создать компанию</h3>
                <p>Станьте владельцем компании, управляйте проектами и приглашайте сотрудников.</p>
                <button class="btn btn-primary" id="createCompanyBtn">Создать компанию</button>
            </div>

            <div class="action-card" id="joinCompanyCard">
                <div class="action-icon">🔗</div>
                <h3>Присоединиться к компании</h3>
                <p>У вас есть код приглашения? Введите его, чтобы стать участником компании.</p>
                <button class="btn btn-secondary" id="joinCompanyBtn">Ввести код</button>
            </div>
        </div>
    }
    else if (hasAnyCompany && !hasOwnCompany)
    {
        <div class="main-panel">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Главная</p>
                    <h2>Последние новости</h2>
                </div>
                <span class="panel-badge">Сегодня</span>
            </div>

            <p class="panel-subtitle">Следите за обновлениями, задачами и событиями вашей компании.</p>

            <div class="news-list">
                <article class="news-item">
                    <div class="news-dot"></div>
                    <div class="news-content">
                        <div class="news-meta">
                            <span class="news-date">Сегодня</span>
                            <span class="news-tag">Сделки</span>
                        </div>
                        <h3>Обновлены статусы по текущим сделкам</h3>
                        <p>Проверьте карточки сделок и завершите согласование с клиентами.</p>
                    </div>
                </article>

                <article class="news-item">
                    <div class="news-dot"></div>
                    <div class="news-content">
                        <div class="news-meta">
                            <span class="news-date">Вчера</span>
                            <span class="news-tag">Команда</span>
                        </div>
                        <h3>Добавлены новые контакты и поставщики</h3>
                        <p>Обновлён справочник позволяет быстрее находить клиентов и партнёров.</p>
                    </div>
                </article>

                <article class="news-item">
                    <div class="news-dot"></div>
                    <div class="news-content">
                        <div class="news-meta">
                            <span class="news-date">На этой неделе</span>
                            <span class="news-tag">Проекты</span>
                        </div>
                        <h3>Следующий дедлайн по проектам уже назначен</h3>
                        <p>Проверьте актуальные задачи и распределите загрузку команды.</p>
                    </div>
                </article>
            </div>
        </div>

        <div class="company-actions" style="margin-top: 30px;">
            <div class="action-card" id="joinCompanyCardOnly">
                <div class="action-icon">🔗</div>
                <h3>Присоединиться к другой компании</h3>
                <p>У вас есть код приглашения? Введите его, чтобы стать участником ещё одной компании.</p>
                <button class="btn btn-secondary" id="joinCompanyBtnOnly">Ввести код</button>
            </div>
        </div>
    }
    else if (hasOwnCompany)
    {
        <div class="main-panel">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Главная</p>
                    <h2>Последние новости</h2>
                </div>
                <span class="panel-badge">Сегодня</span>
            </div>

            <p class="panel-subtitle">Здесь собраны ключевые обновления, задачи и важные события компании.</p>

            <div class="news-list">
                <article class="news-item">
                    <div class="news-dot"></div>
                    <div class="news-content">
                        <div class="news-meta">
                            <span class="news-date">Сегодня</span>
                            <span class="news-tag">Задачи</span>
                        </div>
                        <h3>Скоро будет обновление по текущим задачам</h3>
                        <p>Проверьте остаток задач и отметьте приоритетные пункты для команды.</p>
                    </div>
                </article>

                <article class="news-item">
                    <div class="news-dot"></div>
                    <div class="news-content">
                        <div class="news-meta">
                            <span class="news-date">Вчера</span>
                            <span class="news-tag">Сотрудники</span>
                        </div>
                        <h3>Приглашения сотрудникам готовы к отправке</h3>
                        <p>Добавьте новых участников и настройте доступы для совместной работы.</p>
                    </div>
                </article>

                <article class="news-item">
                    <div class="news-dot"></div>
                    <div class="news-content">
                        <div class="news-meta">
                            <span class="news-date">На этой неделе</span>
                            <span class="news-tag">Контакты</span>
                        </div>
                        <h3>Справочник клиентов и поставщиков обновлён</h3>
                        <p>Теперь все важные записи доступны в одном месте для быстрого поиска.</p>
                    </div>
                </article>
            </div>
        </div>

        <div class="company-actions" style="margin-top: 30px;">
            <div class="action-card" id="joinCompanyCardOwn">
                <div class="action-icon">🔗</div>
                <h3>Присоединиться к другой компании</h3>
                <p>Вас пригласили в другую компанию? Введите код.</p>
                <button class="btn btn-secondary" id="joinCompanyBtnOwn">Ввести код</button>
            </div>
        </div>
    }
</div>

<!-- Подключаем модальные окна -->
@await Html.PartialAsync("/Views/Shared/Company/_InviteModal.cshtml")
@await Html.PartialAsync("/Views/Shared/Company/_CreateCompanyModal.cshtml")

<style>
    /* Общие стили */
    .content-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 24px 40px;
        width: 100%;
        box-sizing: border-box;
    }

    .main-panel {
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
        padding: 28px;
        margin-bottom: 28px;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 8px;
    }

    .eyebrow {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #64748b;
    }

    .panel-header h2 {
        margin: 6px 0 0;
        font-size: clamp(1.8rem, 2vw, 2.4rem);
        line-height: 1.15;
        color: #0f172a;
    }

    .panel-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border-radius: 999px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .panel-subtitle {
        margin: 0 0 24px;
        color: #475569;
        font-size: 1rem;
        line-height: 1.5;
    }

    .news-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 18px;
    }

    .news-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    }

    .news-dot {
        width: 11px;
        height: 11px;
        margin-top: 10px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        box-shadow: 0 0 0 6px rgba(79, 70, 229, 0.12);
        flex-shrink: 0;
    }

    .news-content {
        flex: 1;
    }

    .news-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 8px;
        flex-wrap: wrap;
    }

    .news-date {
        font-size: 0.76rem;
        font-weight: 600;
        color: #64748b;
    }

    .news-tag {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #334155;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .news-item h3 {
        margin: 0 0 8px;
        color: #0f172a;
        font-size: 1.05rem;
        line-height: 1.35;
    }

    .news-item p {
        margin: 0;
        color: #475569;
        line-height: 1.5;
        font-size: 0.92rem;
    }

    .welcome-message {
        text-align: center;
        margin-bottom: 40px;
    }

        .welcome-message h2 {
            font-size: 1.8rem;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .welcome-message p {
            color: #5a6e7c;
            font-size: 1rem;
        }

    /* Горизонтальные плашки с прокруткой */
    .company-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 24px;
        justify-content: center;
        margin: 30px 0;
        padding-bottom: 15px;
        -webkit-overflow-scrolling: touch;
    }

    .action-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        padding: 30px 25px;
        width: 100%;
        min-width: 0;
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
        border: 1px solid #e2e8f0;
    }

        .action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        }

    .action-icon {
        font-size: 48px;
        margin-bottom: 20px;
    }

    .action-card h3 {
        font-size: 1.3rem;
        margin-bottom: 15px;
        color: #2c3e50;
    }

    .action-card p {
        color: #5a6e7c;
        margin-bottom: 25px;
        font-size: 0.9rem;
        line-height: 1.4;
    }

    .btn {
        padding: 10px 24px;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.2s;
        font-weight: 500;
    }

    .btn-primary {
        background: #667eea;
        color: white;
    }

        .btn-primary:hover {
            background: #5a67d8;
        }

        .btn-primary:disabled {
            background: #a0aec0;
            cursor: not-allowed;
            opacity: 0.6;
        }

    .btn-secondary {
        background: #e2e8f0;
        color: #2c3e50;
    }

        .btn-secondary:hover {
            background: #cbd5e1;
        }

        .btn-secondary:disabled {
            background: #e2e8f0;
            cursor: not-allowed;
            opacity: 0.6;
        }

    /* Модальное окно */
    .modal {
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
        display: none;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        background: white;
        padding: 30px;
        border-radius: 20px;
        width: 450px;
        max-width: 90%;
        position: relative;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .close {
        position: absolute;
        top: 15px;
        right: 20px;
        font-size: 28px;
        cursor: pointer;
        color: #aaa;
        transition: color 0.2s;
    }

        .close:hover {
            color: black;
        }

    .modal-content h3 {
        margin-bottom: 20px;
        color: #2c3e50;
        font-size: 1.4rem;
    }

    .modal-content input,
    .modal-content textarea {
        width: 100%;
        padding: 12px;
        margin-bottom: 20px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }

    .modal-content textarea {
        font-family: inherit;
        resize: vertical;
    }

        .modal-content input:focus,
        .modal-content textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .modal-buttons {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
    }

    .error-message {
        margin-top: 15px;
        font-size: 0.85rem;
        text-align: center;
        padding: 8px;
        border-radius: 6px;
    }

        .error-message.error {
            color: #e53e3e;
            background-color: #fff5f5;
            border: 1px solid #feb2b2;
        }

        .error-message.success {
            color: #38a169;
            background-color: #f0fff4;
            border: 1px solid #9ae6b4;
        }

    /* Адаптив */
    @@media (max-width: 768px) {
        .content-section {
            padding-left: 18px;
            padding-right: 18px;
        }

        .main-panel {
            padding: 20px;
        }

        .panel-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .company-actions {
            justify-content: flex-start;
            gap: 20px;
        }

        .action-card {
            padding: 20px 15px;
        }

        .welcome-message h2 {
            font-size: 1.4rem;
        }

        .modal-content {
            width: 90%;
            padding: 20px;
        }
    }

    @@media (max-width: 480px) {
        .action-card {
            width: 260px;
            min-width: 240px;
            padding: 15px 12px;
        }

        .action-icon {
            font-size: 36px;
        }

        .action-card h3 {
            font-size: 1.1rem;
        }

        .btn {
            padding: 8px 16px;
            font-size: 0.85rem;
        }

        .modal-buttons {
            flex-direction: column;
        }

            .modal-buttons .btn {
                width: 100%;
            }
    }
</style>