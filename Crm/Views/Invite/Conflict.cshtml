@* Views/Invite/Conflict.cshtml — приглашение на один email, а вошли под другим *@
@model Crm.Models.Compan.AcceptInvitationViewModel
@{
    ViewData["Title"] = "Другой аккаунт — приглашение в " + Model.CompanyName;
    Layout = "_InviteLayout";
    var codeEncoded = Uri.EscapeDataString(Model.Code ?? "");
    var userName = string.IsNullOrWhiteSpace(Model.CurrentUserName) ? Model.CurrentUserEmail : Model.CurrentUserName;
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "?" : userName.Trim().Substring(0, 1).ToUpperInvariant();
}

<div class="inv-center">
    <div class="inv-state-icon warn" aria-hidden="true"><i class="fa-solid fa-user-lock"></i></div>
    <h2 class="inv-section-title">Вы вошли в другой аккаунт</h2>
    <p class="inv-text">
        Приглашение отправлено на <strong>@Model.Email</strong>, а сейчас вы вошли как
        <strong>@Model.CurrentUserEmail</strong>. Принять его может только владелец этого адреса.
    </p>
</div>

<div class="inv-account">
    <div class="inv-avatar" aria-hidden="true">@userInitial</div>
    <div class="inv-account-body">
        <div class="inv-account-name">@userName</div>
        @if (!string.IsNullOrWhiteSpace(Model.CurrentUserEmail) && Model.CurrentUserEmail != userName)
        {
            <div class="inv-account-email">@Model.CurrentUserEmail</div>
        }
    </div>
    <span class="inv-account-tag">текущий</span>
</div>

<form method="post" action="/invite/@codeEncoded/switch" data-loading-form>
    @Html.AntiForgeryToken()
    <button type="submit" class="inv-btn inv-btn-primary">
        <span class="inv-spinner" aria-hidden="true"></span>
        <i class="fa-solid fa-arrow-right-arrow-left inv-btn-icon" aria-hidden="true"></i>
        <span data-loading-text="Выходим…" data-default-text="Выйти и продолжить как @Model.Email">Выйти и продолжить как @Model.Email</span>
    </button>
</form>
<a class="inv-btn inv-btn-ghost" href="/">Вернуться в CRM</a>
