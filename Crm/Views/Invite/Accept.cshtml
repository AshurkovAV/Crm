@* Views/Invite/Accept.cshtml — регистрация нового сотрудника по приглашению *@
@model Crm.Models.Compan.AcceptInvitationViewModel
@{
    ViewData["Title"] = "Приглашение в " + Model.CompanyName;
    Layout = "_InviteLayout";
    var codeEncoded = Uri.EscapeDataString(Model.Code ?? "");
    var emailLocked = Model.EmailFromInvitation;
}

<h2 class="inv-section-title">Создайте аккаунт</h2>
<p class="inv-text">Заполните пару полей — и вы сразу окажетесь в команде.</p>

@if (Model.HasErrors)
{
    <div class="inv-alert" role="alert">
        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
        <ul class="@(Model.Errors.Count == 1 ? "single" : "")">
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<form id="inviteRegisterForm" method="post" action="/invite/@codeEncoded" novalidate data-loading-form>
    @Html.AntiForgeryToken()

    <div class="inv-field">
        <label class="inv-label" for="DisplayName">Имя и фамилия</label>
        <input class="inv-input" type="text" id="DisplayName" name="DisplayName"
               value="@Model.DisplayName" autocomplete="name" maxlength="100" required
               placeholder="Иван Петров" aria-describedby="DisplayNameError" />
        <div class="inv-error" id="DisplayNameError">Укажите имя — от 2 до 100 символов</div>
    </div>

    <div class="inv-field">
        <label class="inv-label" for="Email">Email</label>
        @if (emailLocked)
        {
            @* Email берётся из приглашения на сервере — в форме только показываем, не отправляем *@
            <div class="inv-input-wrap">
                <input class="inv-input" type="email" id="Email" value="@Model.Email" readonly autocomplete="username" aria-describedby="EmailHint" />
                <i class="fa-solid fa-lock inv-input-icon" aria-hidden="true"></i>
            </div>
            <div class="inv-hint" id="EmailHint">Приглашение отправлено на этот адрес — он станет вашим логином</div>
        }
        else
        {
            <input class="inv-input" type="email" id="Email" name="Email" value="@Model.Email"
                   autocomplete="email" required placeholder="you@company.ru" aria-describedby="EmailError" />
            <div class="inv-error" id="EmailError">Укажите корректный email</div>
        }
    </div>

    <div class="inv-row">
        <div class="inv-field">
            <label class="inv-label" for="Phone">Телефон <span class="opt">— необяз.</span></label>
            <input class="inv-input" type="tel" id="Phone" name="Phone" value="@Model.Phone"
                   autocomplete="tel" inputmode="tel" placeholder="+7 900 000-00-00" />
        </div>
        <div class="inv-field">
            <label class="inv-label" for="Position">Должность <span class="opt">— необяз.</span></label>
            <input class="inv-input" type="text" id="Position" name="Position" value="@Model.Position"
                   autocomplete="organization-title" maxlength="100" placeholder="Менеджер" />
        </div>
    </div>

    <div class="inv-field">
        <label class="inv-label" for="Password">Пароль</label>
        <div class="inv-input-wrap">
            <input class="inv-input has-toggle" type="password" id="Password" name="Password"
                   autocomplete="new-password" minlength="6" maxlength="100" required
                   placeholder="Не менее 6 символов" aria-describedby="PasswordStrengthLabel PasswordError" />
            <button type="button" class="inv-toggle" data-toggle-password="Password" aria-label="Показать пароль" aria-pressed="false">
                <i class="fa-regular fa-eye" aria-hidden="true"></i>
            </button>
        </div>
        <div class="inv-strength" id="PasswordStrength" data-level="0">
            <div class="inv-strength-bar" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            <div class="inv-strength-label" id="PasswordStrengthLabel" aria-live="polite">Не менее 6 символов</div>
        </div>
        <div class="inv-error" id="PasswordError">Пароль должен быть не короче 6 символов</div>
    </div>

    <div class="inv-field">
        <label class="inv-label" for="ConfirmPassword">Повторите пароль</label>
        <div class="inv-input-wrap">
            <input class="inv-input has-toggle" type="password" id="ConfirmPassword" name="ConfirmPassword"
                   autocomplete="new-password" maxlength="100" required aria-describedby="ConfirmPasswordError" />
            <button type="button" class="inv-toggle" data-toggle-password="ConfirmPassword" aria-label="Показать пароль" aria-pressed="false">
                <i class="fa-regular fa-eye" aria-hidden="true"></i>
            </button>
        </div>
        <div class="inv-error" id="ConfirmPasswordError">Пароли не совпадают</div>
    </div>

    <button type="submit" class="inv-btn inv-btn-primary">
        <span class="inv-spinner" aria-hidden="true"></span>
        <i class="fa-solid fa-user-plus inv-btn-icon" aria-hidden="true"></i>
        <span data-loading-text="Создаём аккаунт…" data-default-text="Создать аккаунт и присоединиться">Создать аккаунт и присоединиться</span>
    </button>
</form>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('inviteRegisterForm');
            var nameInput = document.getElementById('DisplayName');
            var emailInput = form.querySelector('input[name="Email"]');
            var pass = document.getElementById('Password');
            var confirm = document.getElementById('ConfirmPassword');
            var strength = document.getElementById('PasswordStrength');
            var strengthLabel = document.getElementById('PasswordStrengthLabel');
            var touched = false;

            function setError(input, errorId, hasError) {
                input.classList.toggle('is-invalid', hasError);
                input.setAttribute('aria-invalid', hasError ? 'true' : 'false');
                var el = document.getElementById(errorId);
                if (el) el.classList.toggle('show', hasError);
            }

            // Простая оценка: длина, регистр, цифры, спецсимволы
            function scorePassword(value) {
                if (!value) return 0;
                if (value.length < 6) return 1;
                var score = 2;
                if (value.length >= 10) score++;
                var kinds = 0;
                if (/[a-zа-яё]/.test(value)) kinds++;
                if (/[A-ZА-ЯЁ]/.test(value)) kinds++;
                if (/\d/.test(value)) kinds++;
                if (/[^A-Za-zА-Яа-яЁё0-9]/.test(value)) kinds++;
                if (kinds >= 3) score++;
                return Math.min(4, score);
            }

            var labels = ['Не менее 6 символов', 'Слишком короткий', 'Слабый', 'Неплохой', 'Надёжный'];

            function updateStrength() {
                var level = scorePassword(pass.value);
                strength.setAttribute('data-level', String(level));
                strengthLabel.textContent = labels[level];
            }

            function validate() {
                var ok = true;
                var name = nameInput.value.trim();
                var nameBad = name.length < 2 || name.length > 100;
                setError(nameInput, 'DisplayNameError', nameBad);
                if (nameBad) ok = false;

                if (emailInput) {
                    var emailBad = !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(emailInput.value.trim());
                    setError(emailInput, 'EmailError', emailBad);
                    if (emailBad) ok = false;
                }

                var passBad = pass.value.length < 6;
                setError(pass, 'PasswordError', passBad);
                if (passBad) ok = false;

                var confirmBad = confirm.value !== pass.value;
                setError(confirm, 'ConfirmPasswordError', confirmBad);
                if (confirmBad) ok = false;

                return ok;
            }

            pass.addEventListener('input', function () {
                updateStrength();
                if (touched) validate();
            });
            [nameInput, emailInput, confirm].forEach(function (input) {
                if (input) input.addEventListener('input', function () { if (touched) validate(); });
            });

            // Только подсказка пользователю: сервер всё равно проверяет данные сам
            form.addEventListener('submit', function (e) {
                touched = true;
                if (!validate()) {
                    e.preventDefault();
                    var firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) firstInvalid.focus();
                }
            });

            updateStrength();
        })();
    </script>
}
