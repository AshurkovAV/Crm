@* Views/Invite/Error.cshtml — приглашение недействительно / ошибка *@
@model Crm.Models.Compan.InvitationErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "_InviteLayout";
    var isAuthenticated = ViewBag.IsAuthenticated as bool? ?? false;
}

<div class="inv-center">
    <div class="inv-state-icon danger" aria-hidden="true"><i class="fa-solid fa-link-slash"></i></div>
    <h1 class="inv-title">@Model.Title</h1>
    <p class="inv-text" style="margin-top: 8px;">@Model.Error</p>
    <p class="inv-text" style="font-size: 13.5px;">Если вы считаете, что это ошибка, попросите коллегу отправить новое приглашение.</p>

    @if (isAuthenticated)
    {
        <a class="inv-btn inv-btn-primary" href="/">
            <i class="fa-solid fa-house" aria-hidden="true"></i>
            <span>Перейти в CRM</span>
        </a>
    }
    else
    {
        <a class="inv-btn inv-btn-primary" href="/Account/Index">
            <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
            <span>Войти</span>
        </a>
    }
</div>
