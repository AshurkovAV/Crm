@model Crm.Models.Compan.AcceptInvitationViewModel

@{
    ViewData["Title"] = "Вход для принятия приглашения";
    Layout = "_Layout";
}

<div class="content-section">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-gradient-primary text-white py-4">
                    <h3 class="mb-0 text-center">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        Вход в систему
                    </h3>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info">
                        <i class="fas fa-envelope me-2"></i>
                        Приглашение отправлено на <strong>@Model.Email</strong>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-info-circle me-2"></i>
                            @Model.Message
                        </div>
                    }

                    <form method="post" asp-action="Login" asp-controller="Invite">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <input type="hidden" name="code" value="@Model.Code" />

                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="Email" name="email" value="@Model.Email" readonly />
                            <label for="Email">Email</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="Password" name="password" placeholder="Пароль" required />
                            <label for="Password">Пароль</label>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-sign-in-alt me-2"></i>Войти и принять приглашение
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>