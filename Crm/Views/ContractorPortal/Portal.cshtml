@{
    Layout = null;
    var token = ViewBag.Token as string;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>Задание для подрядчика</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f6f9;
            color: #20364d;
            min-height: 100vh;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 24px 16px;
        }
        .card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(20, 40, 70, 0.08);
            padding: 28px 22px;
        }
        .contractor-name {
            font-size: 14px;
            color: #6b8195;
            margin-bottom: 4px;
        }
        h1 {
            font-size: 24px;
            margin: 0 0 18px;
            line-height: 1.3;
        }
        .field {
            margin-bottom: 18px;
        }
        .field-label {
            font-size: 13px;
            color: #6b8195;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin-bottom: 6px;
        }
        .field-value {
            font-size: 18px;
            font-weight: 600;
        }
        .deadline {
            color: #b14e5b;
        }
        .status-badge {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 999px;
            font-size: 15px;
            font-weight: 700;
            background: #eef3f7;
            color: #51677b;
        }
        .status-Pending { background: #eef3f7; color: #51677b; }
        .status-InProgress { background: #fff5dc; color: #9a6a00; }
        .status-Done { background: #e6f7ee; color: #218153; }
        .actions {
            margin-top: 26px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .btn {
            display: block;
            width: 100%;
            padding: 20px 16px;
            border: none;
            border-radius: 16px;
            font-size: 20px;
            font-weight: 700;
            cursor: pointer;
            color: #fff;
            text-align: center;
        }
        .btn-accept {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        }
        .btn-ready {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .toast {
            position: fixed;
            left: 16px;
            right: 16px;
            bottom: 24px;
            padding: 14px 16px;
            border-radius: 12px;
            font-size: 15px;
            text-align: center;
            box-shadow: 0 8px 24px rgba(20, 40, 70, 0.15);
            display: none;
            max-width: 420px;
            margin: 0 auto;
        }
        .toast.ok { background: #e6f7ee; color: #218153; display: block; }
        .toast.error { background: #fdebed; color: #b14e5b; display: block; }
        .loading, .not-found {
            text-align: center;
            color: #6b8195;
            font-size: 16px;
            padding: 40px 0;
        }
        .notes {
            font-size: 15px;
            color: #384c60;
            white-space: pre-wrap;
        }
    </style>
</head>
<body>
    <div class="card" id="card">
        <div class="loading" id="loading">Загрузка задания...</div>
    </div>
    <div class="toast" id="toast"></div>

    <script>
        const token = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(token));
        const apiBase = '/api/v1/external/contractor/' + encodeURIComponent(token);
        const card = document.getElementById('card');

        function formatDate(value) {
            if (!value) return 'не указан';
            const d = new Date(value);
            return d.toLocaleDateString('ru-RU') + ' ' + d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
        }

        function statusLabel(status) {
            switch (status) {
                case 'Pending': return 'Ожидает начала';
                case 'InProgress': return 'В работе';
                case 'Done': return 'Готово, отгружено';
                default: return status || '—';
            }
        }

        function render(task) {
            const canAccept = task.status === 'Pending';
            const canReady = task.status === 'InProgress' || task.status === 'Pending';
            const isDone = task.status === 'Done';

            card.innerHTML = `
                <div class="contractor-name">Подрядчик: ${task.contractorName || ''}</div>
                <h1>${task.stageName || 'Этап производства'}</h1>

                <div class="field">
                    <div class="field-label">Изделие</div>
                    <div class="field-value">${task.orderItemName || ''}${task.dealTitle ? ' · ' + task.dealTitle : ''}</div>
                </div>

                ${task.notes ? `
                <div class="field">
                    <div class="field-label">Техническое задание</div>
                    <div class="notes">${task.notes}</div>
                </div>` : ''}

                <div class="field">
                    <div class="field-label">Требуемый срок</div>
                    <div class="field-value deadline">${formatDate(task.deadline)}</div>
                </div>

                <div class="field">
                    <div class="field-label">Статус</div>
                    <span class="status-badge status-${task.status}">${statusLabel(task.status)}</span>
                </div>

                <div class="actions">
                    <button class="btn btn-accept" id="acceptBtn" ${(!canAccept || isDone) ? 'disabled' : ''}>ПРИНЯЛ В РАБОТУ</button>
                    <button class="btn btn-ready" id="readyBtn" ${(isDone) ? 'disabled' : ''}>ГОТОВО, ОТГРУЖЕНО</button>
                </div>
            `;

            document.getElementById('acceptBtn').addEventListener('click', () => doAction('accept'));
            document.getElementById('readyBtn').addEventListener('click', () => doAction('ready'));
        }

        function renderNotFound(text) {
            card.innerHTML = `<div class="not-found">${text}</div>`;
        }

        async function loadTask() {
            try {
                const resp = await fetch(apiBase);
                if (!resp.ok) {
                    const err = await resp.json().catch(() => ({}));
                    renderNotFound(err.message || 'Задание не найдено.');
                    return;
                }
                const task = await resp.json();
                render(task);
            } catch (e) {
                renderNotFound('Не удалось загрузить задание. Проверьте соединение и обновите страницу.');
            }
        }

        function showToast(text, isError) {
            const toast = document.getElementById('toast');
            toast.textContent = text;
            toast.className = 'toast ' + (isError ? 'error' : 'ok');
            clearTimeout(showToast._timer);
            showToast._timer = setTimeout(() => { toast.style.display = 'none'; toast.className = 'toast'; }, 5000);
        }

        async function doAction(action) {
            const acceptBtn = document.getElementById('acceptBtn');
            const readyBtn = document.getElementById('readyBtn');
            acceptBtn.disabled = true;
            readyBtn.disabled = true;

            try {
                const resp = await fetch(apiBase + '/' + action, { method: 'POST' });
                const data = await resp.json().catch(() => ({}));

                if (!resp.ok) {
                    showToast(data.message || 'Не удалось выполнить действие.', true);
                    acceptBtn.disabled = false;
                    readyBtn.disabled = false;
                    return;
                }

                showToast(data.message || 'Готово.', false);
                await loadTask();
            } catch (e) {
                showToast('Ошибка сети. Попробуйте ещё раз.', true);
                acceptBtn.disabled = false;
                readyBtn.disabled = false;
            }
        }

        loadTask();
    </script>
</body>
</html>
