@model Crm.Models.YandexAuthSuccessViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Авторизация успешна</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 50px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .success-icon {
            font-size: 64px;
            margin-bottom: 20px;
        }

        .message {
            font-size: 18px;
            margin-bottom: 30px;
        }

        .loading {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    @if (Model.Succeeded)
    {
        <div class="success-icon">✅</div>
        <h1>Авторизация успешна!</h1>
        <div class="message">Окно закроется автоматически...</div>
        <div class="loading">⏳</div>
    }
    else
    {
        <div class="success-icon">⚠️</div>
        <h1>Не удалось войти</h1>
        <div class="message">@Model.Error</div>
    }

    <script>
        (function () {
            var data = {
                type: @Json.Serialize(Model.Succeeded ? "YANDEX_AUTH_SUCCESS" : "YANDEX_AUTH_ERROR"),
                email: @Json.Serialize(Model.Email),
                name: @Json.Serialize(Model.Name),
                error: @Json.Serialize(Model.Error),
                success: @Json.Serialize(Model.Succeeded)
            };

            // window.opener может оказаться null: после перехода через oauth.yandex.ru браузер
            // (Cross-Origin-Opener-Policy) разрывает связь попапа с основным окном. Поэтому
            // дублируем сообщение через BroadcastChannel/localStorage — они работают между
            // окнами одного origin без opener.
            try {
                if (window.opener) {
                    window.opener.postMessage(data, window.location.origin);
                }
            } catch (e) { }
            try {
                if ('BroadcastChannel' in window) {
                    var channel = new BroadcastChannel('yandex_auth');
                    channel.postMessage(data);
                    channel.close();
                }
            } catch (e) { }
            try {
                localStorage.setItem('yandex_auth_result', JSON.stringify({ data: data, ts: Date.now() }));
            } catch (e) { }

            setTimeout(function () {
                window.close();
                // Если браузер не дал закрыть окно — хотя бы уводим попап с экрана логина.
                setTimeout(function () {
                    if (data.success) window.location.href = '/';
                }, 500);
            }, data.success ? 800 : 3000);
        })();
    </script>
</body>
</html>