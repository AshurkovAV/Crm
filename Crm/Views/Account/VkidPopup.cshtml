@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вход через VK ID</title>
    <style>
        body {
            margin: 0;
            padding: 20px;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f5f5;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 400px;
            text-align: center;
        }

        #loading {
            margin-top: 20px;
        }

        .error-message {
            color: #d32f2f;
            margin-top: 20px;
            padding: 10px;
            border: 1px solid #ffcdd2;
            background-color: #ffebee;
            border-radius: 4px;
        }

        .success-message {
            color: #2e7d32;
            margin-top: 20px;
            padding: 10px;
            border: 1px solid #c8e6c9;
            background-color: #e8f5e8;
            border-radius: 4px;
        }

        #vkid-container {
            display: flex;
            justify-content: center;
            margin: 20px 0;
            min-height: 60px;
        }

        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Вход через VK ID</h2>

        <!-- Контейнер для кнопки VK ID -->
        <div id="vkid-container"></div>
        <div id="loading">Загрузка VK ID...</div>

        <!-- Сообщения об ошибках и успехе -->
        <div id="error-message" class="error-message hidden"></div>
        <div id="success-message" class="success-message hidden"></div>
    </div>

    <!-- Подключаем VK ID SDK -->
    <script src="https://unpkg.com/@@vkid/sdk@@<3.0.0/dist-sdk/umd/index.js"></script>


  <div>
  
  <script type="text/javascript">
    if ('VKIDSDK' in window) {
      const VKID = window.VKIDSDK;

      VKID.Config.init({
        app: 54112877,
        redirectUrl: 'https://crm.biglv.ru/vkauth/callback',
        responseMode: VKID.ConfigResponseMode.Query,
        source: VKID.ConfigSource.LOWCODE,
        scope: '',
      });

      // Обрабатываем возврат из popup
      function handlePopupResult() {
        if (window.location.search.includes('code=') || window.location.hash.includes('code=')) {
          VKID.Auth.loginByAuthToken()
            .then(function(data) {
              console.log('Успешная авторизация:', data);
              // Очищаем URL от параметров авторизации
              window.history.replaceState({}, document.title, window.location.pathname);
            })
            .catch(vkidOnError);
        }
      }

      // Вызываем при загрузке страницы
      handlePopupResult();

      const oneTap = new VKID.OneTap();

      oneTap.render({
        container: document.currentScript.parentElement,
        showAlternativeLogin: true
      })
      .on(VKID.WidgetEvents.ERROR, vkidOnError)
      .on(VKID.OneTapInternalEvents.LOGIN_SUCCESS, function (payload) {
        // Открываем popup для авторизации
        openVKPopup();
      });
    
      function openVKPopup() {
        const width = 600;
        const height = 700;
        const left = (screen.width - width) / 2;
        const top = (screen.height - height) / 2;
        
        const popup = window.open(
          '',
          'VK Auth',
          `width=${width},height=${height},top=${top},left=${left}`
        );

        // Генерируем URL для авторизации
        const authUrl = VKID.Auth.createAuthURL({
          params: {
            redirect_uri: 'https://crm.biglv.ru/vkauth/callback',
            display: 'popup',
            response_type: 'code'
          }
        });

        // Перенаправляем popup на URL авторизации
        popup.location.href = authUrl;

        // Проверяем завершение авторизации в popup
        const checkPopup = setInterval(function() {
          try {
            if (popup.closed) {
              clearInterval(checkPopup);
              // После закрытия popup проверяем результат
              handlePopupResult();
            } else if (popup.location.href.includes('crm.biglv.ru')) {
              // Popup был перенаправлен на наш сайт
              const resultUrl = popup.location.href;
              popup.close();
              clearInterval(checkPopup);
              
              // Извлекаем код из URL
              const urlParams = new URLSearchParams(new URL(resultUrl).search);
              const code = urlParams.get('code');
              
              if (code) {
                // Обмениваем код на токен
                VKID.Auth.exchangeCode(code)
                  .then(vkidOnSuccess)
                  .catch(vkidOnError);
              }
            }
          } catch (e) {
            // Игнорируем ошибки доступа к cross-origin
          }
        }, 100);
      }
    
      function vkidOnSuccess(data) {
        console.log('Успешная авторизация:', data);
        // Здесь сохраняем токен, обновляем UI и т.д.
        alert('Авторизация успешна! Токен: ' + data.access_token);
      }
    
      function vkidOnError(error) {
        console.error('Ошибка авторизации:', error);
        alert('Ошибка авторизации: ' + error.message);
      }
    }
  </script>
</div>

    
  


</body>
</html>