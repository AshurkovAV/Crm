@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Войти в CRM</title>
    <link href="~/css/Site.css" rel="stylesheet" />
    <link href="~/css/authorization/lk.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="~/js/devextreme/jquery.js"></script>
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/localization/dx.messages.ru.js"></script>
    <script src="~/js/modules/auth/authorization.js"></script>
    <script src="https://yastatic.net/s3/passport-sdk/autofill/v1/sdk-suggest-with-polyfills-latest.js"></script>

</head>
<body>
    <!-- Контейнер для фиксированных кнопок -->
    <div class="fixed-buttons-container">
        <a href="/Account/Create" class="create-account">Создать кабинет CRM</a>
        <a href="#" class="policy-link">Политика обработки персональных данных</a>
    </div>

    <!-- Основной контент -->
    <div class="main-content">
        <div class="wrapper fadeInDown">
            <div id="formContent">
                <!-- Tabs Titles -->
                <h2 class="active">Вход в CRM</h2>
                <!-- Login Form -->
                <form id="loginForm" autocomplete="on">
                    <label for="email">E-mail или телефон</label>
                    <input type="text"
                           id="email"
                           class="fadeIn second"
                           name="email"
                           placeholder="name@company.ru">
                    <button type="submit" id="loginButton" class="fadeIn fourth">
                        <span class="button-text">Продолжить</span>
                    </button>
                </form>
                <div class="divider">
                    <span>или</span>
                </div>
                <div class="social-login">
                    <div class="social-item">
                        <div class="social-btn" title="VK">
                            <i class="fab fa-vk"></i>
                        </div>
                    </div>
                    
                    <div class="social-item">
                        <div class="social-btn" title="Mail.ru">
                            <i class="far fa-envelope"></i>
                        </div>
                    </div>

                    <div class="social-item">
                        <div class="social-btn" id="yandexAuthBtn" title="Yandex">
                            <span style="font-weight: bold;">Я</span>
                        </div>
                    </div>

                    <div class="social-item">
                        <div class="social-btn" title="Google">
                            <i class="fab fa-google"></i>
                        </div>
                    </div>
                </div>
                <!-- Контейнер для авторизации через Яндекс -->
                <div id="yandexAuth"></div>

                <!-- Блок для отображения результата авторизации -->
                <div id="authResult" class="yandex-auth-result"></div>
            </div>
        </div>
    </div>

    <script>
        // Обработчик сообщений от popup окна
        window.addEventListener('message', function (event) {
            // Проверяем origin сообщения для безопасности
            if (event.origin !== 'https://crm.biglv.ru') return;

            if (event.data.type === 'YANDEX_AUTH_SUCCESS') {
                console.log('Авторизация успешна через Яндекс');
                console.log('Email:', event.data.email);
                console.log('Name:', event.data.name);

                // Показываем уведомление об успехе
                showAuthSuccessNotification();

                // Перенаправляем на главную страницу
                setTimeout(function () {
                    window.location.href = '/';
                }, 1500);
            }
        });

        // Функция показа уведомления об успешной авторизации
        function showAuthSuccessNotification() {
            const notification = document.createElement('div');
            notification.style.cssText = `
                        position: fixed;
                        top: 20px;
                        right: 20px;
                        background: #28a745;
                        color: white;
                        padding: 15px 20px;
                        border-radius: 5px;
                        z-index: 10000;
                        font-weight: bold;
                    `;
            notification.textContent = 'Авторизация успешна!';
            document.body.appendChild(notification);

            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        document.getElementById('yandexAuthBtn').addEventListener('click', function () {
            // Параметры для центрального расположения окна
            const width = 500;
            const height = 600;

            // Вычисляем позицию для центра экрана
            const left = (window.screen.width - width) / 2;
            const top = (window.screen.height - height) / 2;

            // Формируем URL для OAuth-авторизации
            const authUrl = new URL('https://oauth.yandex.ru/authorize');

            const params = {
                response_type: 'code',
                client_id: '9f8dd7d3ac2b42228103fcbe8f11682f',
                redirect_uri: 'https://crm.biglv.ru/yandexauth/callback',
                scope: 'login:email login:info login:avatar',
                display: 'popup',
                origin: 'https://crm.biglv.ru',
                state: 'your_generated_state',
                prompt: 'select_account', // Принудительно показать выбор аккаунта
                force_confirm: true      // Всегда запрашивать подтверждение
               
            };

            // Добавляем параметры к URL
            Object.keys(params).forEach(key => {
                authUrl.searchParams.append(key, params[key]);
            });

            // Открываем OAuth-окно Яндекс по центру экрана
            const popup = window.open(
                authUrl.toString(),
                'yandex_oauth',
                `width=${width},height=${height},left=${left},top=${top},scrollbars=yes,resizable=yes`
            );

            // Проверяем, открылось ли окно
            if (!popup) {
                alert('Пожалуйста, разрешите всплывающие окна для этого сайта');
                return;
            }
            
        });

        // Функция для обработки callback с токеном (если нужно)
        function handleOAuthCallback() {
            const hash = window.location.hash.substring(1);
            const params = new URLSearchParams(hash);

            if (params.has('access_token')) {
                const accessToken = params.get('access_token');
                console.log('Access Token получен:', accessToken);
            }
        }

        // Проверяем, не вернулись ли мы с токеном
        handleOAuthCallback();
    </script>
</body>
</html>