    }

    .company-details {
        flex: 1;
    }

    .company-name {
        font-size: 16px;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 4px;
    }

    .company-description {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 8px;
    }

    .company-meta {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .meta-badge {
        padding: 4px 8px;
        border-radius: 6px;
