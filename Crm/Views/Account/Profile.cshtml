@model Crm.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Мой профиль";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-section">
    <div class="dx-grid-container">
        <div class="profile-layout">
            <!-- Левая колонка - профиль пользователя -->
            <div class="profile-left">
                <div class="profile-card">
                    <div class="profile-card-body text-center">
                        <!-- Аватар -->
                        <div class="profile-avatar-wrapper">
                            <div class="profile-avatar-circle">
                                <span class="profile-avatar-initial">
                                    @(Model.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                </span>
                            </div>
                        </div>

                        <h3 class="profile-name">@Model.DisplayName</h3>
                        @if (!string.IsNullOrEmpty(Model.RealName) && Model.RealName != Model.DisplayName)
                        {
                            <p class="profile-realname">@Model.RealName</p>
                        }

                        <div class="profile-badges">
                            <span class="profile-badge profile-badge-primary">
                                <i class="fas fa-user-tag"></i> @Model.Role
                            </span>
                           
                        </div>

                        <div class="profile-info-list">
                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="fas fa-envelope"></i>
                                </div>
                                <div class="profile-info-content">
                                    <small>Email</small>
                                    <span>@Model.Email</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <div class="profile-info-item">
                                    <div class="profile-info-icon">
                                        <i class="fas fa-phone"></i>
                                    </div>
                                    <div class="profile-info-content">
                                        <small>Телефон</small>
                                        <span>@Model.Phone</span>
                                    </div>
                                </div>
                            }

                            @if (Model.Birthday.HasValue)
                            {
                                <div class="profile-info-item">
                                    <div class="profile-info-icon">
                                        <i class="fas fa-calendar-alt"></i>
                                    </div>
                                    <div class="profile-info-content">
                                        <small>Дата рождения</small>
                                        <span>@Model.Birthday.Value.ToString("dd MMMM yyyy")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Действия -->
                <div class="profile-actions">
                    <a href="#" class="profile-btn profile-btn-outline" id="editProfileBtn">
                        <i class="fas fa-pencil-alt"></i> Редактировать профиль
                    </a>
                    <a href="#" class="profile-btn profile-btn-primary" id="createCompanyBtn">
                        <i class="fas fa-building"></i> Создать компанию
                    </a>
                    <a href="#" class="profile-btn profile-btn-success" id="joinCompanyBtn">
                        <i class="fas fa-user-plus"></i> Присоединиться к компании
                    </a>
                  
                </div>
            </div>

            <!-- Правая колонка - компании -->
            <div class="profile-right">
                <!-- Текущая компания -->
                @if (Model.CurrentCompany != null)
                {
                    <div class="current-company-card">
                        <div class="current-company-header">
                            <div>
                                <h6 class="current-company-label">
                                    <i class="fas fa-star text-warning"></i> ТЕКУЩАЯ КОМПАНИЯ
                                </h6>
                                <h3 class="current-company-name">@Model.CurrentCompany.CompanyName</h3>
                                @if (!string.IsNullOrEmpty(Model.CurrentCompany.CompanyDescription))
                                {
                                    <p class="current-company-desc">@Model.CurrentCompany.CompanyDescription</p>
                                }
                            </div>
                            @if (Model.CurrentCompany.IsOwner)
                            {
                                <span class="owner-badge">
                                    <i class="fas fa-crown"></i> Владелец
                                </span>
                            }
                        </div>

                        <div class="current-company-stats">
                            <div class="stat-card">
                                <small><i class="fas fa-user-tag"></i> Ваша роль</small>
                                <span>@Model.CurrentCompany.UserRole</span>
                            </div>
                            <div class="stat-card">
                                <small><i class="fas fa-briefcase"></i> Должность</small>
                                <span>@(string.IsNullOrEmpty(Model.CurrentCompany.Position) ? "—" : Model.CurrentCompany.Position)</span>
                            </div>
                            <div class="stat-card">
                                <small><i class="fas fa-calendar-check"></i> Дата присоединения</small>
                                <span>@(Model.CurrentCompany.JoinedDate?.ToString("dd.MM.yyyy") ?? "—")</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert-warning-card">
                        <i class="fas fa-info-circle"></i>
                        <div>
                            <strong>Внимание!</strong> У вас не выбрана текущая компания.<br />
                            <small>Выберите компанию из списка ниже или создайте новую.</small>
                        </div>
                    </div>
                }

                <!-- Мои компании -->
                <div class="companies-card">
                    <div class="companies-header">
                        <h4>
                            <i class="fas fa-building"></i> Мои компании
                        </h4>
                        <span class="companies-count">@Model.Companies.Count</span>
                    </div>

                    @if (Model.Companies.Any())
                    {
                        <div class="companies-list">
                            @foreach (var company in Model.Companies)
                            {
                                <div class="company-item @(company.CompanyId == Model.CurrentCompanyId ? "company-item-active" : "")">
                                    <div class="company-item-main">
                                        <div class="company-icon">
                                            <i class="fas @(company.IsOwner ? "fa-trophy" : "fa-building")"></i>
                                        </div>
                                        <div class="company-details">
                                            <h5 class="company-name">@company.CompanyName</h5>
                                            @if (!string.IsNullOrEmpty(company.CompanyDescription))
                                            {
                                                <p class="company-description">@company.CompanyDescription</p>
                                            }
                                            <div class="company-meta">
                                                <span class="meta-badge meta-badge-info">
                                                    <i class="fas fa-user-tag"></i> @company.UserRole
                                                </span>
                                                @if (company.IsOwner)
                                                {
                                                    <span class="meta-badge meta-badge-warning">
                                                        <i class="fas fa-crown"></i> Владелец
                                                    </span>
                                                }
                                                <span class="meta-badge meta-badge-secondary">
                                                    <i class="fas fa-calendar-plus"></i> @(company.JoinedDate?.ToString("dd.MM.yyyy") ?? "—")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="company-actions">
                                        @if (company.CompanyId != Model.CurrentCompanyId)
                                        {
                                            <form method="post" action="@Url.Action("SwitchCompany", "Profile")">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="companyId" value="@company.CompanyId" />
                                                <button type="submit" class="btn-switch">
                                                    <i class="fas fa-arrow-right"></i> Сделать текущей
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="current-badge">
                                                <i class="fas fa-check-circle"></i> Текущая
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-companies">
                            <i class="fas fa-building-slash"></i>
                            <h5>Нет компаний</h5>
                            <p>Вы пока не состоите ни в одной компании</p>
                            <a href="@Url.Action("Create", "Company")" class="profile-btn profile-btn-primary">
                                <i class="fas fa-plus-circle"></i> Создать первую компанию
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Подключаем общее модальное окно -->
@await Html.PartialAsync("/Views/Shared/Company/_InviteModal.cshtml")
@await Html.PartialAsync("/Views/Shared/Company/_CreateCompanyModal.cshtml")
@await Html.PartialAsync("/Views/Shared/Company/_EditProfileModal.cshtml")
<!-- Стили для профиля -->
