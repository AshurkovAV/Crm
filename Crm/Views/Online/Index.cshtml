@{
    ViewData["Title"] = "Чат и звонки";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chat.css?v=5" />
}

<div class="content-section">
    <div class="content-top-bar">
        <h1 class="content-title">Чат и звонки</h1>
    </div>

    <div class="chat-page">
        <!-- Боковая панель с контактами -->
        <div class="chat-sidebar">
            <div class="sidebar-header">
                <h2>Сотрудники</h2>
            </div>

            <div class="search-container">
                <input type="search" class="search-input" id="contact-search" placeholder="Найти сотрудника" autocomplete="off">
            </div>

            <div class="chat-list" id="online-chat-list">
                <!-- Элементы чатов будут добавлены через JavaScript -->
            </div>
        </div>

        <!-- Основная область чата -->
        <div class="chat-container">
            <div class="chat-header">
                <div class="header-avatar" id="current-chat-avatar">ИМ</div>
                <div class="header-info">
                    <div class="header-name" id="current-chat-name">Выберите чат</div>
                    <div class="header-status" id="current-chat-status">онлайн</div>
                </div>
            </div>

            <div class="messages-container" id="messages-container">
                <div class="message message-incoming">
                    <div>Выберите чат для начала общения</div>
                    <div class="message-time">16:24</div>
                </div>
            </div>

            <div class="input-container">
                <textarea class="message-input" id="message-input" placeholder="Введите сообщение..." rows="1"></textarea>
                <button class="send-button" id="send-button">Отправить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let contacts = [];
        let currentChatId = null;
        let currentChatRole = '';
        let typingTimer = null;

        function getInitials(name) {
            return name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase();
        }

        function renderChatList() {
            const chatList = document.getElementById('online-chat-list');
            const searchTerm = document.getElementById('contact-search').value.trim().toLocaleLowerCase();
            const visibleContacts = contacts.filter(contact =>
                !searchTerm || `${contact.name} ${contact.role}`.toLocaleLowerCase().includes(searchTerm));

            chatList.innerHTML = '';

            if (contacts.length === 0) {
                chatList.innerHTML = '<div class="chat-empty">В вашей компании пока нет других сотрудников</div>';
                return;
            }

            if (visibleContacts.length === 0) {
                chatList.innerHTML = '<div class="chat-empty">Сотрудник не найден</div>';
                return;
            }

            visibleContacts.forEach(chat => {
                const chatItem = document.createElement('div');
                chatItem.className = 'chat-item';
                chatItem.dataset.id = chat.id;

                chatItem.innerHTML = `
                            <div class="chat-avatar">${getInitials(chat.name)}</div>
                            <div class="chat-info">
                                <div class="chat-name"></div>
                                <div class="chat-preview">${chat.role}</div>
                            </div>
                            <div class="chat-time"></div>
                        `;

                chatItem.querySelector('.chat-name').textContent = chat.name;
                chatItem.addEventListener('click', () => selectChat(chat.id));
                chatList.appendChild(chatItem);
            });
        }

        function selectChat(chatId) {
            stopTyping();
            currentChatId = chatId;

            document.querySelectorAll('#online-chat-list .chat-item').forEach(item => {
                item.classList.remove('active');
                if (parseInt(item.dataset.id) === chatId) {
                    item.classList.add('active');
                }
            });

            const chat = contacts.find(c => c.id === chatId);
            document.getElementById('current-chat-name').textContent = chat.name;
            document.getElementById('current-chat-avatar').textContent = getInitials(chat.name);
            currentChatRole = chat.role;
            setChatStatus(currentChatRole);

            loadMessages(chatId);
        }

        function resetChatWindow() {
            currentChatId = null;
            currentChatRole = '';
            stopTyping();
            document.getElementById('current-chat-name').textContent = 'Выберите сотрудника';
            document.getElementById('current-chat-avatar').textContent = '...';
            document.getElementById('current-chat-status').textContent = 'Внутренняя переписка';
            document.getElementById('messages-container').innerHTML = `
                <div class="message message-incoming">
                    <div>Выберите сотрудника слева, чтобы начать переписку</div>
                </div>`;
        }

        async function loadContacts() {
            const response = await fetch('/Online/Contacts');
            if (!response.ok) throw new Error('Не удалось загрузить сотрудников');
            contacts = (await response.json()).filter(contact => !contact.isCurrentUser);
            renderChatList();
            resetChatWindow();
        }

        async function loadMessages(chatId) {
            const response = await fetch(`/Online/Messages?userId=${encodeURIComponent(chatId)}`);
            if (!response.ok) throw new Error('Не удалось загрузить сообщения');
            if (currentChatId !== chatId) return;
            renderMessages(await response.json());
        }

        function renderMessages(chatMessages) {
            const messagesContainer = document.getElementById('messages-container');
            messagesContainer.innerHTML = '';

            if (chatMessages.length === 0) {
                messagesContainer.innerHTML = `
                            <div class="message message-incoming">
                                <div>Начните переписку</div>
                            </div>
                        `;
                return;
            }

            chatMessages.forEach(msg => {
                const messageElement = document.createElement('div');
                messageElement.className = `message ${msg.incoming ? 'message-incoming' : 'message-outgoing'}`;

                messageElement.innerHTML = `
                            <div class="message-text"></div>
                            <div class="message-time">${new Date(msg.sentAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</div>
                        `;

                messageElement.querySelector('.message-text').textContent = msg.text;
                messagesContainer.appendChild(messageElement);
            });

            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        async function sendMessage() {
            if (!currentChatId) {
                return;
            }

            const input = document.getElementById('message-input');
            const text = input.value.trim();
            if (text === '') return;
            if (!text) return;

            stopTyping();

            const response = await fetch('/Online/Send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ recipientUserId: currentChatId, text })
            });

            if (!response.ok) {
                const error = await response.json().catch(() => null);
                alert(error?.message || 'Не удалось отправить сообщение');
                return;
            }

            input.value = '';
            input.style.height = 'auto';
            await loadMessages(currentChatId);
        }

        function setChatStatus(status) {
            document.getElementById('current-chat-status').textContent = status;
        }

        async function updateTypingState(isTyping) {
            if (!currentChatId) return;

            await fetch('/Online/Typing', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ recipientUserId: currentChatId, isTyping })
            }).catch(() => {});
        }

        function stopTyping() {
            window.clearTimeout(typingTimer);
            updateTypingState(false);
        }

        async function refreshTypingStatus() {
            if (!currentChatId) return;

            const response = await fetch(`/Online/TypingStatus?userId=${encodeURIComponent(currentChatId)}`);
            if (!response.ok || !currentChatId) return;

            const result = await response.json();
            setChatStatus(result.isTyping ? 'печатает...' : currentChatRole);
        }

        document.addEventListener('DOMContentLoaded', async () => {
            document.getElementById('send-button').addEventListener('click', sendMessage);
            document.getElementById('contact-search').addEventListener('input', renderChatList);
            document.getElementById('message-input').addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            const messageInput = document.getElementById('message-input');
            messageInput.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';

                if (!currentChatId || !this.value.trim()) {
                    stopTyping();
                    return;
                }

                updateTypingState(true);
                window.clearTimeout(typingTimer);
                typingTimer = window.setTimeout(stopTyping, 1500);
            });

            try {
                await loadContacts();
            } catch (error) {
                document.getElementById('online-chat-list').innerHTML = '<div class="chat-empty">Не удалось загрузить сотрудников</div>';
            }

            window.setInterval(() => {
                if (currentChatId) loadMessages(currentChatId).catch(() => {});
            }, 5000);

            window.setInterval(() => {
                refreshTypingStatus().catch(() => {});
            }, 1000);
        });
    </script>
}