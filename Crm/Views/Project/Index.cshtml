@using Crm.Entity.ModelsCrm

@{
    ViewData["Title"] = "Проекты";
}

<div class="content-top-bar">
    <h1 class="content-title">Проекты</h1>
    <div class="content-actions">
        <button class="content-btn" onclick="showCreateProjectModal()">
            <i class="fas fa-plus"></i>
            <span>Новый проект</span>
        </button>
        <button class="content-btn secondary">
            <i class="fas fa-filter"></i>
            <span>Фильтр</span>
        </button>
    </div>
</div>

<div class="content-section">
    <div class="dx-grid-container">
        @(Html.DevExtreme().DataGrid<Project>()
                .ID("projectsGrid")
                .DataSource(ds => ds.Mvc()
                .Controller("ProjectData")
                .LoadAction("Get")
                .InsertAction("Post")
                .UpdateAction("Put")
                .DeleteAction("Delete")
                .Key("Id")
                )
                .ShowBorders(true)
                .ColumnAutoWidth(true)
                .WordWrapEnabled(true)
                .ShowColumnLines(true)
                .ShowRowLines(true)
                .RowAlternationEnabled(true)
                .Grouping(g => g.AutoExpandAll(false))
                .Pager(p => p
                .ShowPageSizeSelector(true)
                .AllowedPageSizes(new[] { 10, 20, 50 })
                .ShowInfo(true)
                )
                .Paging(p => p.PageSize(10))
                .Editing(e => e
                .Mode(GridEditMode.Popup)
                .AllowAdding(true)
                .AllowUpdating(true)
                .AllowDeleting(true)
                .UseIcons(true)
                .Popup(p => p
                .Title("Редактирование проекта")
                .ShowTitle(true)
                .Width(860)
                .Height(800)
                .Position(pos => pos
                .My(HorizontalAlignment.Center, VerticalAlignment.Center)
                .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                .Of(new JS("window"))
                )
                
                )
                .Form(f => f
                .ColCount(2)
                .LabelLocation(FormLabelLocation.Top)
                .Items(items =>
                {
                        // Первая колонка
                        items.AddGroup()
                    .Caption("Основная информация")
                    .ColSpan(1)
                    .Items(groupItems =>
                    {                                     

                                    groupItems.AddSimpleFor(m => m.Name)
                                        .Label(l => l.Text("Название проекта*"))
                                        .Editor(editor => editor
                                        .TextBox()
                                        .Placeholder("Введите название проекта")
                                    );
                                     groupItems.AddSimpleFor(m => m.Activity)
                                        .Label(l => l.Text("Описание проекта"))
                                        .Editor(editor => editor
                                        .TextArea()
                                        .Height(80)
                                        .Placeholder("Опишите проект")
                                    );

                                       
                                    });

                                // Вторая колонка
                                items.AddGroup()
                            .Caption("Дополнительная информация")
                            .ColSpan(1)
                            .Items(groupItems =>
                            {
                                    groupItems.AddSimpleFor(m => m.Status)
                                    .Label(l => l.Text("Статус*"))
                                    .Editor(editor => editor
                                    .SelectBox()
                                    .DataSource(new[] {
                                            "В работе",
                                            "Завершен",
                                            "На паузе",
                                            "Планируется",
                                            "Черновик",
                                            "Отменен"
                                                })
                                    .Placeholder("Выберите статус")
                                    );
                                    // Поле для выбора участников
                                    groupItems.AddSimpleFor(m => m.Participants)
                                    .Label(l => l.Text("Текущие участники"))
                                    .Editor(editor => editor
                                            .TagBox()
                                            .DataSource(d => d.Mvc()
                                            .Controller("ProjectUserData")
                                            .LoadAction("GetParticipants")
                                            .LoadMode(DataSourceLoadMode.Processed)) // Изменено на Processed
                                    .ValueExpr("Id")
                                    .DisplayExpr("DisplayName")
                                    .Placeholder("Выберите участников")
                                    .SearchEnabled(true)
                                    .ShowSelectionControls(true)
                                    .ShowClearButton(true)
                                    .Width("100%")
                                    )
                                    .ColSpan(2);
                                    
                    groupItems.AddGroup()
                .Caption("Участники")
                .ColCount(2)
                .Items(items =>
                {
                   

                    // Кнопка для добавления нового участника
                    items.AddSimple()
                .Label(l => l.Text("Пригласить по ссылке"))
                .Template(@"
                        <div style='padding: 5px 0;'>
                        <button type='button'
                        onclick='showInviteModal()'
                        style='width: 100%;
                        padding: 10px 15px;
                        background: #1976d2;
                        color: white;
                        border: none;
                        border-radius: 4px;
                        cursor: pointer;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        gap: 8px;'>
                        <i class='dx-icon-user'></i>
                        <span>Добавить участника</span>
                        </button>
                        </div>
                        ")
                .ColSpan(2);

                    // Скрытое поле для отображения ссылки
                    items.AddSimple()
                .Label(l => l.Text("Ссылка для приглашения"))
                .Template(@"
                            <div id='inviteLinkContainer' style=' margin-top: 10px; padding: 15px; background: #f5f5f5; border-radius: 5px; border: 1px dashed #ddd;'>
                            <div style='display: flex; align-items: center; gap: 10px;'>
                            <div style='flex: 1; font-family: monospace; padding: 8px; background: white; border: 1px solid #ccc; border-radius: 3px; word-break: break-all;'>
                            <span id='inviteLinkText'>https://ваш-сайт.ru/invite/XXXXXXXXXXXX</span>
                            </div>
                            <div style='display: flex; gap: 5px;'>
                            <button onclick='copyInviteLink()' style='padding: 6px 12px; background: white; border: 1px solid #ccc; border-radius: 3px; cursor: pointer;'>
                            <i class='dx-icon-copy' style='margin-right: 5px;'></i>
                            Копировать
                            </button>
                            <button onclick='sendInviteLink()' style='padding: 6px 12px; background: #1976d2; color: white; border: none; border-radius: 3px; cursor: pointer;'>
                            <i class='dx-icon-email' style='margin-right: 5px;'></i>
                            Отправить
                            </button>
                            </div>
                            </div>
                            <div style='margin-top: 10px; font-size: 12px; color: #666;'>
                            <i class='dx-icon-info'></i> Ссылка действительна 7 дней
                            </div>
                            </div>
                            ")
                .ColSpan(2);
                });
                  
                });
                })
                )
                )
                .Columns(columns =>
                {
                    columns.Add()
                        .DataField("Name")
                        .Caption("Название проекта");

                    columns.Add()
                            .DataField("Activity")
                            .Caption("Описание")
                            .Visible(true);
                    columns.Add()
                .DataField("Participants")
                .Caption("Участники")
                .Visible(true)
                .CellTemplate(@<text>
            <div>
                <%= value && value.length > 0 ?
                value.map(function(p) {
                return p.User ? p.User.DisplayName || p.User.FullName || 'Участник' : 'Участник';
                }).join(', ') : 'Нет участников' %>
            </div>
        </text>)
                .CalculateDisplayValue(new JS(@"
        function(data) {
        // Формируем строку для отображения
        if(data.Participants && data.Participants.length > 0) {
        return data.Participants.map(function(p) {
        return p.User ? p.User.DisplayName || p.User.FullName || 'Участник' : 'Участник';
        }).join(', ');
        }
        return 'Нет участников';
        }
        "));
                    columns.Add()
                            .DataField("Status")
                            .Caption("Статус")
                            .CellTemplate(@<text>
                                            <span class="status-badge status-<%= getStatusClass(data.Status) %>">
                                                <%= value %>
                                            </span>
                                        </text>);

                    columns.Add()
            .DataField("CreatedDate")
            .Caption("Создан")
            .DataType(GridColumnDataType.DateTime)
            .Format("dd.MM.yyyy HH:mm")
            .Width(120)
            .AllowEditing(false);

                    columns.Add()
            .DataField("ModifiedDate")
            .Caption("Изменен")
            .DataType(GridColumnDataType.DateTime)
            .Format("dd.MM.yyyy HH:mm")
            .Width(120)
            .Visible(false);

                    columns.Add()
            .Type(GridCommandColumnType.Buttons)
            .Width(120)
            .Buttons(b =>
            {
                    b.Add()
                        .Name(GridColumnButtonName.Edit) // Встроенная кнопка редактирования
                        .Hint("Редактировать")
                        .Icon("edit");

                    b.Add()
                        .Name(GridColumnButtonName.Delete)
                        .Hint("Удалить")
                        .Icon("trash")
                        .OnClick("deleteButtonClick");
                });
                })
            .OnContentReady("function(e) { e.component.option('loadPanel.enabled', false); }")
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .Selection(s => s.Mode(SelectionMode.Single))
            )
    </div>
</div>

<script>
    function deleteButtonClick(e) {
        const dataGrid = $("#projectsGrid").dxDataGrid("instance");
        const selectedRowData = dataGrid.getSelectedRowsData();

        if (selectedRowData.length > 0) {
            DevExpress.ui.dialog.confirm("Вы уверены, что хотите удалить эту запись?", "Подтверждение удаления")
                .done(function (dialogResult) {
                    if (dialogResult) {
                        const id = selectedRowData[0].Id; // Получаем ID выбранной строки

                        // AJAX запрос на удаление
                        $.ajax({
                            url: '/ProjectData/' + id,
                            type: 'DELETE',
                            contentType: 'application/json',
                            success: function () {
                                dataGrid.refresh();
                                DevExpress.ui.notify("Удаление выполнено успешно", "success", 2000);
                            },
                            error: function (error) {
                                DevExpress.ui.notify("Ошибка при удалении: " + error.responseText, "error", 4000);
                            }
                        });


                    }
                });
        } else {
            DevExpress.ui.notify("Выберите строку для удаления", "warning", 2000);
        }
    }
</script>

<script>
    function editButtonClick(e) {
        const dataGrid = $("#projectsGrid").dxDataGrid("instance");
        const selectedRowData = dataGrid.getSelectedRowsData();

        if (selectedRowData.length > 0) {
            console.log(selectedRowData[0].Id);
            // Получаем ключ выбранной строки
            const rowKey = selectedRowData[0].Id;

            // Открываем редактирование в popup режиме
            dataGrid.option('editing.mode', 'popup');
            dataGrid.editRow(rowKey);

        } else {
            DevExpress.ui.notify("Выберите строку для редактирования", "warning", 2000);
        }
    }
</script>

@section Scripts {
    <script>
        function getStatusClass(status) {
            const statusMap = {
                'В работе': 'active',
                'Завершен': 'completed',
                'На паузе': 'paused',
                'Планируется': 'planned',
                'Черновик': 'draft',
                'Отменен': 'cancelled'
            };
            return statusMap[status] || 'default';
        }

        function showCreateProjectModal() {
            const dataGrid = $('#projectsGrid').dxDataGrid('instance');
            dataGrid.addRow();
        }       

        function refreshGrid() {
            $('#projectsGrid').dxDataGrid('instance').refresh();
        }

        $(document).ready(function () {
            setTimeout(function () {
                const dataGrid = $('#projectsGrid').dxDataGrid('instance');
                if (dataGrid) {
                    console.log('DataGrid initialized successfully');
                }
            }, 1000);
        });
    </script>
}

