@using Crm.Entity.ModelsCrm

@{
    ViewData["Title"] = "Сделки";
}

<div class="content-top-bar">
    <h1 class="content-title">Сделки</h1>
    <div class="content-actions">
        <button class="content-btn" type="button" onclick="addDeal()">
            <i class="fas fa-plus"></i>
            <span>Новая сделка</span>
        </button>
        <button class="content-btn secondary" type="button" onclick="toggleDealFilter()">
            <i class="fas fa-filter"></i>
            <span>Фильтр</span>
        </button>
    </div>
</div>

<div class="content-section deals-section">
    <div class="deals-toolbar">
        <div>
            <h2>Воронка продаж</h2>
            <p>Управляйте сделками вашей компании в одном месте</p>
        </div>
        <div class="deals-summary" id="deals-summary">Загрузка сделок...</div>
    </div>

    <div class="dx-grid-container">
        @(Html.DevExtreme().DataGrid<Deal>()
                .ID("dealsGrid")
                .DataSource(ds => ds.Mvc()
                .Controller("DealData")
                .LoadAction("Get")
                .InsertAction("Post")
                .UpdateAction("Put")
                .DeleteAction("Delete")
                .Key("Id"))
                .ShowBorders(false)
                .ColumnAutoWidth(true)
                .WordWrapEnabled(true)
                .RowAlternationEnabled(true)
                .HoverStateEnabled(true)
                .SearchPanel(s => s.Visible(true).Placeholder("Найти сделку..."))
                .FilterRow(f => f.Visible(false))
                .HeaderFilter(h => h.Visible(true))
                .Paging(p => p.PageSize(10))
                .Pager(p => p
                .ShowPageSizeSelector(true)
                .AllowedPageSizes(new[] { 10, 20, 50 })
                .ShowInfo(true))
                .Editing(e => e
                .Mode(GridEditMode.Popup)
                .AllowAdding(true)
                .AllowUpdating(true)
                .AllowDeleting(true)
                .UseIcons(true)
                .RefreshMode(GridEditRefreshMode.Reshape)
                .Popup(p => p
                .Title("Сделка")
                .ShowTitle(true)
                .Width(720)
                .Height(570)
                .DragEnabled(true)
                .ResizeEnabled(true)
                .Position(pos => pos
                .My(HorizontalAlignment.Center, VerticalAlignment.Center)
                .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                .Of(new JS("window"))))
                .Form(f => f
                .ColCount(2)
                .LabelLocation(FormLabelLocation.Top)
                .OnContentReady("formContentReady")  // <-- ДОБАВЛЯЕМ
                .Items(items =>
                {
                    items.AddGroup()
                .Caption("Основная информация")
                .ColSpan(2)
                .ColCount(2)
                .Items(group =>
                {
                    group.AddSimpleFor(m => m.Title)
                .ColSpan(2)
                .Label(l => l.Text("Название сделки"))
                .IsRequired(true)
                .Editor(editor => editor.TextBox().Placeholder("Например, поставка оборудования"));

                    group.AddSimpleFor(m => m.ClientId)
                .Label(l => l.Text("Клиент"))
                .Editor(editor => editor
                .SelectBox()
                .DataSource(d => d.Mvc()
                .Controller("Contacts")
                .LoadAction("Lookup")
                .Key("ClientId")
                )
                .ValueExpr("ClientId")
                .DisplayExpr("Name")
                .SearchEnabled(true)
                .ShowClearButton(true)
                .Placeholder("Выберите контакт")
                )
                .Name("ClientIdEditor");  // <-- ДОБАВЛЯЕМ ИМЯ

                    group.AddSimpleFor(m => m.Amount)
                .Label(l => l.Text("Сумма"))
                .Editor(editor => editor.NumberBox().Min(0).Format("#,##0.00 ₽"));
                });

                    items.AddGroup()
                .Caption("Этап и сроки")
                .ColSpan(2)
                .ColCount(2)
                .Items(group =>
                {
                    group.AddSimpleFor(m => m.Status)
                .Label(l => l.Text("Статус"))
                .Editor(editor => editor.SelectBox()
                .DataSource(new[] { "Новая", "В работе", "Переговоры", "Успешно", "Проиграна" })
                .SearchEnabled(false));

                    group.AddSimpleFor(m => m.ExpectedCloseDate)
                .Label(l => l.Text("Плановая дата закрытия"))
                .Editor(editor => editor.DateBox().Type(DateBoxType.Date).DisplayFormat("dd.MM.yyyy"));

                    group.AddSimpleFor(m => m.Description)
                .ColSpan(2)
                .Label(l => l.Text("Описание"))
                .Editor(editor => editor.TextArea().Height(90).Placeholder("Кратко опишите сделку"));
                });
                }))
                )
                .Columns(columns =>
                {
                    columns.AddFor(m => m.Title).Caption("Сделка").MinWidth(220);
                    columns.AddFor(m => m.ClientName).Caption("Клиент").MinWidth(160);
                    columns.AddFor(m => m.Amount).Caption("Сумма").Format("#,##0.00 ₽").Width(140);
                    columns.AddFor(m => m.Status).Caption("Статус").Width(140)
                .CellTemplate(@<text>
            <span class="deal-status deal-status-<%= (value || '').toLowerCase().replaceAll(' ', '-') %>"><%= value %></span>
        </text>);
                    columns.AddFor(m => m.ExpectedCloseDate).Caption("Закрытие").DataType(GridColumnDataType.Date).Format("dd.MM.yyyy").Width(130);
                    columns.AddFor(m => m.ModifiedDate).Caption("Изменена").DataType(GridColumnDataType.DateTime).Format("dd.MM.yyyy HH:mm").Width(150);
                    columns.Add().Type(GridCommandColumnType.Buttons).Width(105);
                })
            .OnContentReady("updateDealsSummary")
            .OnInitNewRow("handleInitNewRow")
            .OnRowUpdating("handleRowUpdating")
            .OnSaving("handleSaving")
            .OnRowInserted("refreshDealsSummary")
            .OnRowUpdated("refreshDealsSummary")
            .OnRowRemoved("refreshDealsSummary")
            .OnEditorPreparing("handleEditorPreparing")
            .AllowColumnReordering(true)
            .AllowColumnResizing(true))
    </div>
</div>

<style>
    .deals-section {
        padding: 0;
        overflow: hidden;
    }

    .deals-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 22px 24px 18px;
        border-bottom: 1px solid #e5edf4;
        background: #ffffff;
    }

        .deals-toolbar h2 {
            margin: 0 0 4px;
            color: #20364d;
            font-size: 18px;
        }

        .deals-toolbar p {
            margin: 0;
            color: #7b8da0;
            font-size: 13px;
        }

    .deals-summary {
        color: #6b8195;
        font-size: 13px;
        white-space: nowrap;
    }

    .deals-section .dx-grid-container {
        padding: 0 12px 12px;
    }

    .deal-status {
        display: inline-flex;
        align-items: center;
        min-height: 26px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #eef3f7;
        color: #51677b;
        font-size: 12px;
        font-weight: 600;
    }

    .deal-status-новая {
        background: #eaf3ff;
        color: #2872bd;
    }

    .deal-status-в-работе, .deal-status-переговоры {
        background: #fff5dc;
        color: #9a6a00;
    }

    .deal-status-успешно {
        background: #e6f7ee;
        color: #218153;
    }

    .deal-status-проиграна {
        background: #fdebed;
        color: #b14e5b;
    }

    @@media (max-width: 700px) {
        .deals-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .deals-summary {
            white-space: normal;
        }
    }
</style>

@section Scripts {
    <script>
        function addDeal() {
            $('#dealsGrid').dxDataGrid('instance').addRow();
        }

        function toggleDealFilter() {
            const grid = $('#dealsGrid').dxDataGrid('instance');
            grid.option('filterRow.visible', !grid.option('filterRow.visible'));
        }

        function updateDealsSummary(e) {
            const count = e.component.totalCount();
            document.getElementById('deals-summary').textContent = `${count} сделок`;
        }

        function refreshDealsSummary(e) {
            e.component.refresh();
        }

        function handleInitNewRow(e) {
            e.data.ClientId = null;
        }

        // <-- ГЛАВНОЕ РЕШЕНИЕ: устанавливаем значение после загрузки формы
        function formContentReady(e) {
            setTimeout(function () {
                const grid = $('#dealsGrid').dxDataGrid('instance');
                const editRowKey = grid.option('editing.editRowKey');

                if (editRowKey !== undefined) {
                    // Получаем данные строки
                    grid.byKey(editRowKey).done(function (data) {
                        if (data && data.ClientId !== undefined && data.ClientId !== null) {
                            const form = e.component;
                            const editor = form.getEditor('ClientId');
                            if (editor) {
                                editor.option('value', data.ClientId);
                                console.log('formContentReady: ClientId set to', data.ClientId);
                            }
                        }
                    }).fail(function () {
                        // Если byKey не работает, ищем в кэше
                        try {
                            const dataSource = grid.getDataSource();
                            const items = dataSource.items();
                            const foundItem = items.find(item => (item.Id || item.id) === editRowKey);
                            if (foundItem && foundItem.ClientId !== undefined && foundItem.ClientId !== null) {
                                const form = e.component;
                                const editor = form.getEditor('ClientId');
                                if (editor) {
                                    editor.option('value', foundItem.ClientId);
                                    console.log('formContentReady (cache): ClientId set to', foundItem.ClientId);
                                }
                            }
                        } catch (err) {
                            console.warn('Could not set ClientId in form', err);
                        }
                    });
                }
            }, 300);
        }

        function handleEditorPreparing(e) {
            if (e.parentType === 'dataRow' && e.dataField === 'ClientId') {
                if (e.row && e.row.data) {
                    // Проверяем, что значение не null и не undefined
                    if (e.row.data.ClientId !== undefined && e.row.data.ClientId !== null) {
                        e.value = e.row.data.ClientId;
                        console.log('EditorPreparing: ClientId set to', e.value);
                    }
                }
            }
        }

        function handleSaving(e) {
            console.log('handleSaving called', e);

            if (!e.changes || e.changes.length === 0) {
                const grid = $('#dealsGrid').dxDataGrid('instance');
                const editRowKey = grid.option('editing.editRowKey');
                if (editRowKey !== undefined) {
                    const form = $('.dx-popup-content .dx-form').dxForm('instance');
                    const clientIdEditor = form && form.getEditor('ClientId');
                    if (clientIdEditor) {
                        const clientId = clientIdEditor.option('value');
                        if (clientId !== undefined && clientId !== null) {
                            e.changes = [{
                                type: 'update',
                                key: editRowKey,
                                data: {
                                    ClientId: clientId,
                                    _forceUpdate: new Date().getTime()
                                }
                            }];
                            console.log('Forced changes with ClientId:', clientId);
                        }
                    }
                }
                return;
            }

            const change = e.changes[0];
            const form = $('.dx-popup-content .dx-form').dxForm('instance');
            const clientIdEditor = form && form.getEditor('ClientId');

            if (change.type === 'update' || change.type === 'insert') {
                if (!change.data) {
                    change.data = {};
                }
                if (clientIdEditor) {
                    const clientId = clientIdEditor.option('value');
                    if (clientId !== undefined && clientId !== null) {
                        change.data.ClientId = clientId;
                        console.log('handleSaving: ClientId set to', change.data.ClientId);
                    }
                }
            }
        }

        function handleRowUpdating(e) {
            console.log('handleRowUpdating called', e);

            const form = $('.dx-popup-content .dx-form').dxForm('instance');
            const clientIdEditor = form && form.getEditor('ClientId');

            if (clientIdEditor) {
                const value = clientIdEditor.option('value');
                if (value !== undefined && value !== null) {
                    e.newData.ClientId = value;
                    console.log('RowUpdating: ClientId =', e.newData.ClientId);
                }
            } else if (e.oldData && e.oldData.ClientId !== undefined && e.oldData.ClientId !== null) {
                e.newData.ClientId = e.oldData.ClientId;
            }

            if (e.newData && Object.keys(e.newData).length === 0) {
                e.newData._forceUpdate = new Date().getTime();
            }
        }
    </script>
}