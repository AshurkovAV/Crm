@inject Crm.Services.Workspace.IWorkspaceService Workspace
@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString() ?? string.Empty;
    var workspaceMode = Crm.Navigation.WorkspaceMode.Normalize(await Workspace.GetCurrentModeAsync());
    var isTasksMode = workspaceMode == Crm.Navigation.WorkspaceMode.Tasks;

    bool Is(params string[] names) => names.Any(n => string.Equals(n, controller, StringComparison.OrdinalIgnoreCase));

    // Пункты «+ Создать» (верхняя кнопка и центральная кнопка нижней панели на телефоне)
    var createItems = new List<(string Title, string Icon, string Url)>
    {
        ("Задача", "fa-solid fa-list-check", "/Tasks"),
        ("Проект", "fa-solid fa-folder", "/Project"),
    };
    if (!isTasksMode)
    {
        createItems.Add(("Сделка", "fa-solid fa-handshake", "/Deals"));
    }
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Crm</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@@400;500;600;700;800&subset=cyrillic,latin&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    @* Оболочка подключается ДО стилей страниц: стили из секции Styles перекрывают её при равной специфичности *@
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />

    <script src="~/js/chat/site.js?v=2"></script>

    @await RenderSectionAsync("Styles", required: false)
    <link href="~/css/devextreme/dx.material.blue.light.css" rel="stylesheet" />

    <script src="~/js/devextreme/jquery.js"></script>

    <!-- Quill должен быть подключён ДО dx.all.js, иначе HtmlEditor падает с E1041 -->
    <script src="~/js/devextreme/dx-quill.min.js"></script>
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/bootstrap.js"></script>

    <!-- Нужны для DataGrid.exportToExcel() -->
    <script src="~/js/devextreme/exceljs.min.js"></script>
    <script src="~/js/devextreme/FileSaver.min.js"></script>

    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/localization/dx.messages.ru.js"></script>
    <script>
        DevExpress.localization.locale('ru');
    </script>
</head>
<body class="app-body @(isTasksMode ? "mode-tasks" : "mode-full")" data-workspace-mode="@workspaceMode">

    <a class="skip-link" href="#contentArea">Перейти к содержимому</a>

    <!-- Затемнение под выдвижным меню (планшет/телефон) -->
    <div class="app-overlay" id="overlay" data-shell-close hidden></div>

    <!-- Левое меню -->
    <aside class="app-sidebar" id="appSidebar" aria-label="Боковое меню">
        @await Component.InvokeAsync("Sidebar", new { mode = workspaceMode })
    </aside>

    <!-- Верхняя панель -->
    <header class="app-topbar">
        <button type="button" class="tb-icon tb-burger" data-shell-open aria-label="Открыть меню" aria-controls="appSidebar" aria-expanded="false">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
        <a class="tb-brand" href="/" aria-label="CRM — на главную">
            <span class="sb-brand-mark" aria-hidden="true"></span>
            <span class="sb-brand-word">CRM</span>
        </a>

        <form class="tb-search" role="search" action="#" onsubmit="return false;">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" id="shellSearch" placeholder="@(isTasksMode ? "Поиск по задачам и проектам…" : "Поиск по сделкам, клиентам, задачам…")" aria-label="Поиск" autocomplete="off">
            <kbd aria-hidden="true">Ctrl K</kbd>
        </form>

        <div class="tb-spacer"></div>

        <div class="tb-create" data-menu>
            <button type="button" class="tb-create-btn" id="createToggle" aria-haspopup="true" aria-expanded="false" aria-controls="createMenu">
                <i class="fa-solid fa-plus" aria-hidden="true"></i><span>Создать</span>
            </button>
            <div class="tb-menu" id="createMenu" role="menu" hidden>
                @foreach (var item in createItems)
                {
                    <a role="menuitem" class="tb-menu-item" href="@item.Url"><i class="@item.Icon" aria-hidden="true"></i><span>@item.Title</span></a>
                }
            </div>
        </div>

        <a href="/Online" class="tb-icon tb-chat @(Is("Online") ? "is-active" : "")" id="chatToggle" aria-label="Чат">
            <i class="fa-regular fa-comment" aria-hidden="true"></i>
        </a>

        <button type="button" class="tb-icon tb-bell" aria-label="Уведомления">
            <i class="fa-regular fa-bell" aria-hidden="true"></i>
        </button>

        <div class="tb-profile">
            @await Component.InvokeAsync("Icon")

            <!-- Выпадающее меню профиля -->
            <div class="profile-dropdown" id="profileDropdown" hidden>
                @await Component.InvokeAsync("Profile")

                <div class="profile-menu">
                    <a href="/Profile" class="profile-item">
                        <i class="fa-regular fa-circle-user" aria-hidden="true"></i>
                        <span>Мой профиль</span>
                    </a>
                    <a href="/company" class="profile-item">
                        <i class="fa-solid fa-users" aria-hidden="true"></i>
                        <span>Сотрудники</span>
                    </a>
                </div>

                <div class="profile-footer">
                    <button type="button" class="logout-btn">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>Выйти
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Контейнер для чата (используется js/chat/site.js) -->
    <div id="chatContainer" style="display: none; position: absolute; left: -9999px;">
        @await Component.InvokeAsync("Chat")
    </div>

    <div class="container app-container">
        <main class="main-content" id="mainContent">
            <div id="contentArea" tabindex="-1">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Нижняя панель (телефон) -->
    <nav class="app-tabbar" aria-label="Быстрая навигация">
        <a href="/" class="tab-item @(Is("Home", "Dashboard") ? "is-active" : "")" aria-current="@(Is("Home", "Dashboard") ? "page" : null)">
            <i class="fa-solid fa-house" aria-hidden="true"></i><span>Главная</span>
        </a>
        <a href="/Tasks" class="tab-item @(Is("Tasks") ? "is-active" : "")" aria-current="@(Is("Tasks") ? "page" : null)">
            <i class="fa-solid fa-list-check" aria-hidden="true"></i><span>Задачи</span>
        </a>
        <div class="tab-fab-wrap" data-menu>
            <button type="button" class="tab-fab" id="createFab" aria-label="Создать" aria-haspopup="true" aria-expanded="false" aria-controls="createSheet">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
            </button>
            <div class="tb-menu tab-sheet" id="createSheet" role="menu" hidden>
                @foreach (var item in createItems)
                {
                    <a role="menuitem" class="tb-menu-item" href="@item.Url"><i class="@item.Icon" aria-hidden="true"></i><span>@item.Title</span></a>
                }
            </div>
        </div>
        @if (isTasksMode)
        {
            <a href="/Vault" class="tab-item @(Is("Vault") ? "is-active" : "")" aria-current="@(Is("Vault") ? "page" : null)">
                <i class="fa-solid fa-key" aria-hidden="true"></i><span>Пароли</span>
            </a>
        }
        else
        {
            <a href="/Deals" class="tab-item @(Is("Deals", "Crm") ? "is-active" : "")" aria-current="@(Is("Deals", "Crm") ? "page" : null)">
                <i class="fa-solid fa-handshake" aria-hidden="true"></i><span>Сделки</span>
            </a>
        }
        <button type="button" class="tab-item" data-shell-open aria-controls="appSidebar" aria-expanded="false">
            <i class="fa-solid fa-grip" aria-hidden="true"></i><span>Ещё</span>
        </button>
    </nav>

    <script>
        (function () {
            'use strict';
            var body = document.body;
            var sidebar = document.getElementById('appSidebar');
            var overlay = document.getElementById('overlay');
            var profileToggle = document.getElementById('profileToggle');
            var profileDropdown = document.getElementById('profileDropdown');

            /* ---------- Уведомление об ошибке ---------- */
            function shellNotify(message, type) {
                if (window.DevExpress && DevExpress.ui && DevExpress.ui.notify) {
                    DevExpress.ui.notify({ message: message, width: 'auto', position: { my: 'bottom center', at: 'bottom center', offset: '0 -96' } }, type || 'error', 4000);
                } else {
                    alert(message);
                }
            }
            window.shellNotify = shellNotify;

            /* ---------- Выдвижное меню (< 1100px) ---------- */
            var openers = document.querySelectorAll('[data-shell-open]');
            var lastFocus = null;

            function setDrawer(open) {
                body.classList.toggle('shell-drawer-open', open);
                overlay.hidden = !open;
                openers.forEach(function (b) { b.setAttribute('aria-expanded', open ? 'true' : 'false'); });
                if (open) {
                    lastFocus = document.activeElement;
                    var first = sidebar.querySelector('.sb-close') || sidebar.querySelector('a, button');
                    if (first) setTimeout(function () { first.focus(); }, 50);
                } else if (lastFocus && document.contains(lastFocus)) {
                    lastFocus.focus();
                    lastFocus = null;
                }
            }
            window.shellToggleSidebar = function (open) {
                setDrawer(typeof open === 'boolean' ? open : !body.classList.contains('shell-drawer-open'));
            };

            openers.forEach(function (b) {
                b.addEventListener('click', function () { setDrawer(true); });
            });
            document.querySelectorAll('[data-shell-close]').forEach(function (el) {
                el.addEventListener('click', function () { setDrawer(false); });
            });
            window.matchMedia('(min-width: 1100px)').addEventListener('change', function (e) {
                if (e.matches && body.classList.contains('shell-drawer-open')) setDrawer(false);
            });

            /* ---------- Всплывающие меню ---------- */
            var popups = [];
            function registerPopup(toggle, panel) {
                if (!toggle || !panel) return;
                var p = { toggle: toggle, panel: panel };
                popups.push(p);
                toggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var willOpen = panel.hidden;
                    closePopups();
                    if (willOpen) {
                        panel.hidden = false;
                        toggle.setAttribute('aria-expanded', 'true');
                        toggle.classList.add('is-open');
                    }
                });
                panel.addEventListener('click', function (e) { e.stopPropagation(); });
            }
            function closePopups(except) {
                popups.forEach(function (p) {
                    if (p === except || p.panel.hidden) return;
                    p.panel.hidden = true;
                    p.toggle.setAttribute('aria-expanded', 'false');
                    p.toggle.classList.remove('is-open');
                });
            }
            registerPopup(profileToggle, profileDropdown);
            registerPopup(document.getElementById('createToggle'), document.getElementById('createMenu'));
            registerPopup(document.getElementById('createFab'), document.getElementById('createSheet'));
            registerPopup(document.getElementById('sbOrgToggle'), document.getElementById('sbOrgMenu'));

            document.addEventListener('click', function () { closePopups(); });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    var open = popups.filter(function (p) { return !p.panel.hidden; })[0];
                    if (open) { closePopups(); open.toggle.focus(); return; }
                    if (body.classList.contains('shell-drawer-open')) setDrawer(false);
                }
                // Ctrl/Cmd + K — фокус в поиск
                if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K' || e.key === 'л' || e.key === 'Л')) {
                    var search = document.getElementById('shellSearch');
                    if (search && search.offsetParent !== null) { e.preventDefault(); search.focus(); }
                }
            });

            /* ---------- Выход ---------- */
            var logoutBtn = document.querySelector('.logout-btn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    window.location.href = '/Account/logout';
                });
            }

            /* ---------- Режим работы компании ---------- */
            document.querySelectorAll('[data-workspace-mode]').forEach(function (btn) {
                if (btn.tagName !== 'BUTTON') return;
                btn.addEventListener('click', function () {
                    var mode = btn.getAttribute('data-workspace-mode');
                    if (mode === body.getAttribute('data-workspace-mode')) return;
                    var group = btn.parentElement;
                    group.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
                    group.classList.add('is-busy');

                    fetch('/api/workspace/mode', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ mode: mode })
                    })
                        .then(function (r) {
                            return r.json().catch(function () { return {}; }).then(function (data) {
                                if (!r.ok || data.success === false) {
                                    throw new Error((data && (data.message || data.error)) || ('HTTP ' + r.status));
                                }
                                location.href = '/';
                            });
                        })
                        .catch(function (err) {
                            group.querySelectorAll('button').forEach(function (b) { b.disabled = false; });
                            group.classList.remove('is-busy');
                            shellNotify('Не удалось сменить режим: ' + (err && err.message ? err.message : 'ошибка сети'));
                        });
                });
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
