@* Views/Shared/Company/_InvitationModalStyles.cshtml *@

<style>
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .modal-dialog {
        max-width: 500px;
        width: 100%;
    }

    .modal-content {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .modal-header {
        padding: 20px 25px;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .modal-title {
        margin: 0;
        font-size: 20px;
        color: #333;
    }

    .close {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #666;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
    }

        .close:hover {
            background: #f0f0f0;
        }

    .modal-body {
        padding: 25px;
    }

    .invitation-header {
        margin-bottom: 20px;
    }

        .invitation-header h3 {
            margin: 0 0 5px 0;
            color: #333;
            font-size: 18px;
        }

    .description {
        color: #666;
        margin: 0;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 500;
            font-size: 14px;
        }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        transition: border-color 0.3s;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.1);
        }

    textarea.form-control {
        resize: vertical;
        font-family: inherit;
    }

    select.form-control {
        background: white;
        cursor: pointer;
    }

    .hint {
        display: block;
        margin-top: 5px;
        color: #888;
        font-size: 12px;
    }

    .send-invite-btn {
        background: #007bff;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-size: 14px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.3s;
        margin-top: 10px;
        width: 100%;
        justify-content: center;
    }

        .send-invite-btn:hover {
            background: #0056b3;
        }

        .send-invite-btn i {
            font-size: 16px;
        }
</style>