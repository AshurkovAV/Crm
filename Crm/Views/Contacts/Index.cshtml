@using Crm.Entity.ModelsCrm

@{
    ViewData["Title"] = "Контакты";
}

<div class="content-top-bar">
    <h1 class="content-title">Контакты клиентов</h1>
    <div class="content-actions">
        <button class="content-btn" type="button" onclick="addContact()">
            <i class="fas fa-plus"></i>
            <span>Новый контакт</span>
        </button>
        <button class="content-btn secondary" type="button" onclick="toggleContactFilter()">
            <i class="fas fa-filter"></i>
            <span>Фильтр</span>
        </button>
    </div>
</div>

<div class="content-section contacts-section">
    <div class="contacts-toolbar">
        <div>
            <h2>Клиенты</h2>
            <p>Контактная база клиентов CRM</p>
        </div>
        <div class="contacts-summary" id="contacts-summary">Загрузка контактов...</div>
    </div>

    <div class="dx-grid-container">
        @(Html.DevExtreme().DataGrid<Client>()
            .ID("contactsGrid")
            .DataSource(ds => ds.Mvc()
                .Controller("Contacts")
                .LoadAction("Get")
                .InsertAction("Post")
                .UpdateAction("Put")
                .DeleteAction("Delete")
                .Key("ClientId"))
            .ShowBorders(false)
            .ColumnAutoWidth(true)
            .WordWrapEnabled(true)
            .RowAlternationEnabled(true)
            .HoverStateEnabled(true)
            .SearchPanel(s => s.Visible(true).Placeholder("Найти контакт..."))
            .FilterRow(f => f.Visible(false))
            .HeaderFilter(h => h.Visible(true))
            .Paging(p => p.PageSize(10))
            .Pager(p => p.ShowPageSizeSelector(true).AllowedPageSizes(new[] { 10, 20, 50 }).ShowInfo(true))
            .Editing(e => e
                .Mode(GridEditMode.Popup)
                .AllowAdding(true)
                .AllowUpdating(true)
                .AllowDeleting(true)
                .UseIcons(true)
                .Popup(p => p
                    .Title("Контакт клиента")
                    .ShowTitle(true)
                    .Width(720)
                    .Height(610)
                    .DragEnabled(true)
                    .ResizeEnabled(true)
                    .Position(pos => pos
                        .My(HorizontalAlignment.Center, VerticalAlignment.Center)
                        .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                        .Of(new JS("window"))))
                .Form(f => f
                    .ColCount(2)
                    .LabelLocation(FormLabelLocation.Top)
                    .Items(items =>
                    {
                        items.AddGroup()
                            .Caption("Основная информация")
                            .ColSpan(2)
                            .ColCount(2)
                            .Items(group =>
                            {
                                group.AddSimpleFor(m => m.Name)
                                    .ColSpan(2)
                                    .Label(l => l.Text("Название клиента"))
                                    .IsRequired(true)
                                    .Editor(editor => editor.TextBox().Placeholder("Название компании или клиента"));

                                group.AddSimpleFor(m => m.ContactPerson)
                                    .Label(l => l.Text("Контактное лицо"))
                                    .Editor(editor => editor.TextBox().Placeholder("Фамилия и имя"));

                                group.AddSimpleFor(m => m.TaxNumber)
                                    .Label(l => l.Text("ИНН"))
                                    .Editor(editor => editor.TextBox());
                            });

                        items.AddGroup()
                            .Caption("Связь")
                            .ColSpan(2)
                            .ColCount(2)
                            .Items(group =>
                            {
                                group.AddSimpleFor(m => m.Phone)
                                    .Label(l => l.Text("Телефон"))
                                    .Editor(editor => editor.TextBox().Mode(TextBoxMode.Tel));

                                group.AddSimpleFor(m => m.Email)
                                    .Label(l => l.Text("Email"))
                                    .Editor(editor => editor.TextBox().Mode(TextBoxMode.Email));

                                group.AddSimpleFor(m => m.Address)
                                    .ColSpan(2)
                                    .Label(l => l.Text("Адрес"))
                                    .Editor(editor => editor.TextBox());

                                group.AddSimpleFor(m => m.Notes)
                                    .ColSpan(2)
                                    .Label(l => l.Text("Заметки"))
                                    .Editor(editor => editor.TextArea().Height(80));
                            });
                    })))
            .Columns(columns =>
            {
                columns.AddFor(m => m.Name).Caption("Клиент").MinWidth(220);
                columns.AddFor(m => m.ContactPerson).Caption("Контактное лицо").MinWidth(180);
                columns.AddFor(m => m.Phone).Caption("Телефон").Width(150);
                columns.AddFor(m => m.Email).Caption("Email").MinWidth(190);
                columns.AddFor(m => m.TaxNumber).Caption("ИНН").Width(130);
                columns.AddFor(m => m.IsActive).Caption("Активен").Width(100);
                columns.AddFor(m => m.CreatedDate).Caption("Добавлен").DataType(GridColumnDataType.Date).Format("dd.MM.yyyy").Width(125);
                columns.Add().Type(GridCommandColumnType.Buttons).Width(105);
            })
            .OnContentReady("updateContactsSummary")
            .OnRowInserted("refreshContactsSummary")
            .OnRowUpdated("refreshContactsSummary")
            .OnRowRemoved("refreshContactsSummary")
            .AllowColumnReordering(true)
            .AllowColumnResizing(true))
    </div>
</div>

<style>
    .contacts-section { padding: 0; overflow: hidden; }
    .contacts-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 22px 24px 18px;
        border-bottom: 1px solid #e5edf4;
        background: #fff;
    }
    .contacts-toolbar h2 { margin: 0 0 4px; color: #20364d; font-size: 18px; }
    .contacts-toolbar p { margin: 0; color: #7b8da0; font-size: 13px; }
    .contacts-summary { color: #6b8195; font-size: 13px; white-space: nowrap; }
    .contacts-section .dx-grid-container { padding: 0 12px 12px; }
    @@media (max-width: 700px) {
        .contacts-toolbar { align-items: flex-start; flex-direction: column; }
        .contacts-summary { white-space: normal; }
    }
</style>

@section Scripts {
    <script>
        function addContact() {
            $('#contactsGrid').dxDataGrid('instance').addRow();
        }

        function toggleContactFilter() {
            const grid = $('#contactsGrid').dxDataGrid('instance');
            grid.option('filterRow.visible', !grid.option('filterRow.visible'));
        }

        function updateContactsSummary(e) {
            document.getElementById('contacts-summary').textContent = `${e.component.totalCount()} контактов`;
        }

        function refreshContactsSummary(e) {
            e.component.refresh();
        }
    </script>
}
