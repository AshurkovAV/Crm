@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <link href="~/css/Site.css" rel="stylesheet" />
    <link href="~/css/authorization/lk.css" rel="stylesheet" />
    <link href="~/css/authorization/setup.css" rel="stylesheet" />
    <script src="~/js/modules/auth/setup.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создаём ваш CRM</title>   
</head>
<body>
    <div class="fixed-buttons-container"></div>

    <div class="main-content">
        <div class="wrapper fadeInDown">
            <div id="formContent">
                <div class="container">
                    <div class="logo">
                        <div class="logo-text">Создаем ваш CRM</div>
                    </div>     

                    <div class="progress-container">
                        <div class="progress-bar" id="progressBar"></div>
                    </div>
                    
                    <div class="status-text" id="statusText" style="display: none;"></div>

                    <div class="completion-message" id="completionMessage">
                        Настройка завершена! Перенаправление в систему...
                    </div>

                    <div class="error-message" id="errorMessage"></div>
                </div>
            </div>
        </div>
    </div>    
</body>
</html>