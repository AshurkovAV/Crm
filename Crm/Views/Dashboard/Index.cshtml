@{
    ViewData["Title"] = "Рабочий стол";
}

<div class="content-top-bar">
    <h1 class="content-title">Рабочий стол</h1>
    <div class="content-actions">
        <button class="content-btn">
            <i class="fas fa-plus"></i>
            <span>Создать</span>
        </button>
        <button class="content-btn secondary">
            <i class="fas fa-filter"></i>
            <span>Фильтр</span>
        </button>
    </div>
</div>

<div class="content-section">
    <h2>Рабочий стол</h2>
    <p>Добро пожаловать в CRM! Выберите раздел в левом меню для работы.</p>
</div>

<div class="content-section">
    <h2>Последние активности</h2>
    <p>Здесь будет отображаться ваша последняя активность в системе.</p>
</div>

<div class="content-section">
    <h2>Мои задачи</h2>
    <table>
        <thead>
            <tr>
                <th>Задача</th>
                <th>Приоритет</th>
                <th>Срок</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Подготовить отчет по продажам</td>
                <td>Высокий</td>
                <td>15.05.2023</td>
                <td>В работе</td>
            </tr>
            <tr>
                <td>Созвать собрание отдела</td>
                <td>Средний</td>
                <td>12.05.2023</td>
                <td>Завершено</td>
            </tr>
            <tr>
                <td>Обновить контакты клиентов</td>
                <td>Низкий</td>
                <td>20.05.2023</td>
                <td>Не начато</td>
            </tr>
        </tbody>
    </table>
</div>