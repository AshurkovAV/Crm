@model Crm.Entity.DTO.PublicTrackingDto
@{
    // Отдельная публичная страница (Модуль Г ТЗ, "эффект Додо") — без Layout,
    // без внутреннего меню/сайдбара CRM. Смотри Views/Public/_ViewStart.cshtml.
    var companyInitial = string.IsNullOrWhiteSpace(Model.CompanyName) ? "?" : Model.CompanyName.Trim().Substring(0, 1).ToUpperInvariant();
    var expectedDateText = Model.ExpectedCloseDate.HasValue ? Model.ExpectedCloseDate.Value.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("ru-RU")) : null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Заказ «@Model.DealTitle» — @Model.CompanyName</title>
    <style>
        :root {
            --brand: #6366f1;
            --brand-dark: #4f46e5;
            --brand-light: #eef2ff;
            --success: #16a34a;
            --success-light: #dcfce7;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --text: #1e293b;
            --text-secondary: #64748b;
            --border: #e2e8f0;
            --bg: #f4f5fb;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        html, body {
            background: var(--bg);
            color: var(--text);
        }

        .page-wrap {
            max-width: 560px;
            margin: 0 auto;
            padding: 24px 16px 48px;
        }

        /* Шапка с "логотипом" компании */
        .brand-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
        }

        .brand-avatar {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--brand) 0%, #8b5cf6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 22px;
            box-shadow: 0 6px 16px rgba(99, 102, 241, 0.3);
        }

        .brand-name {
            font-weight: 700;
            font-size: 18px;
            color: var(--text);
            line-height: 1.2;
        }

        .brand-subtitle {
            font-size: 13px;
            color: var(--text-secondary);
        }

        /* Карточка сделки */
        .hero-card {
            background: white;
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 6px 24px rgba(30, 41, 59, 0.06);
            margin-bottom: 16px;
        }

        .hero-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .status-badge {
            display: inline-block;
            background: var(--brand-light);
            color: var(--brand-dark);
            font-size: 13px;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 999px;
            margin-bottom: 14px;
        }

        .expected-date {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        /* Прогресс-бар */
        .progress-card {
            background: white;
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 6px 24px rgba(30, 41, 59, 0.06);
            margin-bottom: 16px;
        }

        .progress-top-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 12px;
        }

        .progress-label {
            font-size: 14px;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .progress-percent {
            font-size: 26px;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .progress-bar-track {
            height: 12px;
            border-radius: 999px;
            background: #eef0f6;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg, var(--brand) 0%, #8b5cf6 100%);
            transition: width 0.6s ease;
        }

        /* Изделия */
        .items-heading {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 24px 0 12px 4px;
        }

        .item-card {
            background: white;
            border-radius: 18px;
            padding: 20px;
            box-shadow: 0 6px 24px rgba(30, 41, 59, 0.06);
            margin-bottom: 16px;
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 6px;
        }

        .item-name {
            font-weight: 700;
            font-size: 16px;
        }

        .item-qty {
            font-size: 13px;
            color: var(--text-secondary);
            white-space: nowrap;
            padding-top: 2px;
        }

        .item-status {
            font-size: 13px;
            color: var(--brand-dark);
            font-weight: 600;
            margin-bottom: 16px;
        }

        /* Шаги производства */
        .stages-track {
            display: flex;
            align-items: center;
            overflow-x: auto;
            padding-bottom: 6px;
            gap: 2px;
        }

        .stage-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 66px;
            flex-shrink: 0;
        }

        .stage-dot {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 6px;
            border: 2px solid var(--border);
            color: var(--text-secondary);
            background: white;
        }

        .stage-label {
            font-size: 11px;
            text-align: center;
            color: var(--text-secondary);
            line-height: 1.3;
            max-width: 76px;
        }

        .stage-step.state-done .stage-dot {
            background: var(--success);
            border-color: var(--success);
            color: white;
        }

        .stage-step.state-done .stage-label {
            color: var(--success);
            font-weight: 600;
        }

        .stage-step.state-current .stage-dot {
            background: var(--warning-light);
            border-color: var(--warning);
            color: var(--warning);
            animation: pulse 1.6s infinite;
        }

        .stage-step.state-current .stage-label {
            color: var(--text);
            font-weight: 600;
        }

        .stage-arrow {
            color: var(--border);
            font-size: 16px;
            flex-shrink: 0;
            padding: 0 2px 20px;
        }

        .stage-arrow.done {
            color: var(--success);
        }

        .stage-empty {
            font-size: 13px;
            color: var(--text-secondary);
            font-style: italic;
            padding: 4px 0;
        }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4);
            }

            70% {
                box-shadow: 0 0 0 8px rgba(245, 158, 11, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0);
            }
        }

        /* Фото ОТК */
        .item-photo {
            margin-top: 16px;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        .item-photo img {
            width: 100%;
            display: block;
            max-height: 360px;
            object-fit: cover;
            background: #f1f5f9;
        }

        .photo-caption {
            font-size: 12px;
            color: var(--text-secondary);
            padding: 8px 12px;
            background: #f8fafc;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Футер */
        .page-footer {
            text-align: center;
            margin-top: 28px;
            font-size: 12px;
            color: var(--text-secondary);
        }

        .live-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--success);
            margin-right: 6px;
            animation: pulse 2s infinite;
        }

        .refresh-btn {
            display: inline-block;
            margin-top: 10px;
            background: white;
            border: 1px solid var(--border);
            color: var(--brand-dark);
            font-size: 12px;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 999px;
            cursor: pointer;
        }

            .refresh-btn:hover {
                background: var(--brand-light);
            }

        @@media (max-width: 380px) {
            .page-wrap {
                padding: 16px 10px 40px;
            }

            .hero-card, .progress-card, .item-card {
                padding: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrap">
        <div class="brand-header">
            <div class="brand-avatar">@companyInitial</div>
            <div>
                <div class="brand-name">@Model.CompanyName</div>
                <div class="brand-subtitle">Отслеживание заказа онлайн</div>
            </div>
        </div>

        <div class="hero-card">
            <div class="hero-title">@Model.DealTitle</div>
            @if (!string.IsNullOrWhiteSpace(Model.DealStatus))
            {
                <span class="status-badge" id="dealStatusBadge">@Model.DealStatus</span>
            }
            @if (expectedDateText != null)
            {
                <div class="expected-date">📅 Ожидаемая готовность: <strong>&nbsp;@expectedDateText</strong></div>
            }
        </div>

        <div class="progress-card">
            <div class="progress-top-row">
                <div class="progress-label">Общая готовность заказа</div>
                <div class="progress-percent" id="progressPercent">@Model.OverallProgressPercent%</div>
            </div>
            <div class="progress-bar-track">
                <div class="progress-bar-fill" id="progressBarFill" style="width: @Model.OverallProgressPercent%"></div>
            </div>
        </div>

        @if (Model.Items.Count > 0)
        {
            <div class="items-heading">Изделия в заказе (@Model.Items.Count)</div>
        }

        <div id="itemsContainer">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                var item = Model.Items[i];
                <div class="item-card" data-item-index="@i">
                    <div class="item-header">
                        <div class="item-name">@item.Name</div>
                        <div class="item-qty">× @item.Quantity.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)</div>
                    </div>
                    <div class="item-status" data-role="item-status">@item.Status</div>

                    @if (item.Stages.Count > 0)
                    {
                        <div class="stages-track" data-role="stages-track">
                            @for (var s = 0; s < item.Stages.Count; s++)
                            {
                                var stage = item.Stages[s];
                                <div class="stage-step state-@stage.State" data-stage-index="@s">
                                    <div class="stage-dot">@(stage.State == "done" ? "✓" : (stage.State == "current" ? "●" : "○"))</div>
                                    <div class="stage-label">@stage.StageName</div>
                                </div>
                                if (s < item.Stages.Count - 1)
                                {
                                    <div class="stage-arrow @(stage.State == "done" ? "done" : "")">→</div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="stage-empty" data-role="stages-track">Этапы производства ещё не назначены</div>
                    }

                    <div data-role="item-photo-slot">
                        @if (!string.IsNullOrEmpty(item.PhotoUrl))
                        {
                            <div class="item-photo">
                                <img src="@item.PhotoUrl" alt="Фото ОТК: @item.Name" loading="lazy" />
                                <div class="photo-caption">📷 Фото контроля качества (ОТК)</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="page-footer">
            <div><span class="live-dot"></span>Страница обновляется автоматически</div>
            <button class="refresh-btn" id="refreshBtn" type="button">Обновить сейчас</button>
        </div>
    </div>

    <script>
        (function () {
            // Токен берём из самого URL страницы (/track/{token}) — на странице
            // сознательно нет никаких других идентификаторов сделки/клиента.
            var pathParts = window.location.pathname.split('/').filter(Boolean);
            var token = pathParts[pathParts.length - 1];
            var apiUrl = '/api/v1/public/track/' + encodeURIComponent(token);

            var stageIcon = { done: '✓', current: '●', pending: '○' };

            function applyUpdate(data) {
                var percentEl = document.getElementById('progressPercent');
                var barEl = document.getElementById('progressBarFill');
                if (percentEl) percentEl.textContent = data.OverallProgressPercent + '%';
                if (barEl) barEl.style.width = data.OverallProgressPercent + '%';

                var badge = document.getElementById('dealStatusBadge');
                if (badge && data.DealStatus) badge.textContent = data.DealStatus;

                var items = data.Items || [];
                items.forEach(function (item, i) {
                    var card = document.querySelector('.item-card[data-item-index="' + i + '"]');
                    if (!card) return;

                    var statusEl = card.querySelector('[data-role="item-status"]');
                    if (statusEl) statusEl.textContent = item.Status;

                    var stages = item.Stages || [];
                    stages.forEach(function (stage, s) {
                        var stepEl = card.querySelector('.stage-step[data-stage-index="' + s + '"]');
                        if (!stepEl) return;
                        stepEl.className = 'stage-step state-' + stage.State;
                        var dot = stepEl.querySelector('.stage-dot');
                        if (dot) dot.textContent = stageIcon[stage.State] || '○';
                    });

                    var photoSlot = card.querySelector('[data-role="item-photo-slot"]');
                    if (photoSlot && item.PhotoUrl && !photoSlot.querySelector('img')) {
                        photoSlot.innerHTML =
                            '<div class="item-photo">' +
                            '<img src="' + item.PhotoUrl + '" alt="Фото ОТК" loading="lazy" />' +
                            '<div class="photo-caption">📷 Фото контроля качества (ОТК)</div>' +
                            '</div>';
                    }
                });
            }

            function refresh() {
                fetch(apiUrl, { headers: { 'Accept': 'application/json' } })
                    .then(function (res) { return res.ok ? res.json() : null; })
                    .then(function (data) { if (data) applyUpdate(data); })
                    .catch(function () { /* тихо игнорируем — оставляем последнее известное состояние */ });
            }

            var refreshBtn = document.getElementById('refreshBtn');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', function () {
                    refreshBtn.textContent = 'Обновляем…';
                    refresh();
                    setTimeout(function () { refreshBtn.textContent = 'Обновить сейчас'; }, 800);
                });
            }

            // Автообновление раз в 30 секунд — клиент видит статус без звонков менеджеру.
            setInterval(refresh, 30000);
        })();
    </script>
</body>
</html>
