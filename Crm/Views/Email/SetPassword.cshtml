@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создание пароля - Crm.System</title>
    <link href="~/css/authorization/validate.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .password-container {
            background: rgba(255, 255, 255, 0.95);
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            margin: 20px 0;
        }

        .password-input-group {
            position: relative;
            margin-bottom: 20px;
        }

        .password-input {
            width: 100%;
            padding: 16px 20px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 16px;
            transition: all 0.3s ease;
            background: white;
        }

            .password-input:focus {
                border-color: #7c4dff;
                box-shadow: 0 4px 20px rgba(124, 77, 255, 0.3);
                outline: none;
            }

        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #666;
            cursor: pointer;
            font-size: 18px;
        }

        .requirements {
            margin: 20px 0;
        }

        .requirement-item {
            display: flex;
            align-items: center;
            margin: 8px 0;
            font-size: 14px;
            color: #666;
        }

        .requirement-icon {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }

        .requirement-met {
            color: #69f0ae;
        }

        .requirement-not-met {
            color: #ff5252;
        }

        .save-button {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #7c4dff, #651fff);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(124, 77, 255, 0.4);
        }

            .save-button:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(124, 77, 255, 0.6);
            }

            .save-button:disabled {
                background: #ccc;
                cursor: not-allowed;
                transform: none;
                box-shadow: none;
            }

        .email-display {
            text-align: center;
            margin: 15px 0;
            padding: 12px;
            background: rgba(124, 77, 255, 0.1);
            border-radius: 8px;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="circle circle-1"></div>
        <div class="circle circle-2"></div>

        <!-- Конфетти -->
        <div class="confetti" style="background: #ff5252; top: 12%; left: 18%;"></div>
        <div class="confetti" style="background: #ffd740; top: 8%; right: 22%;"></div>
        <div class="confetti" style="background: #7c4dff; bottom: 18%; left: 12%;"></div>
        <div class="confetti" style="background: #69f0ae; bottom: 12%; right: 18%;"></div>

        <div class="card-header">
            <h1>Придумайте пароль для Crm.System</h1>
            <div class="email-display" id="userEmail">@ViewBag.Email</div>
        </div>

        <div class="password-container">
            <div class="password-input-group">
                <input type="password" id="password" class="password-input" placeholder="Придумайте пароль"
                       oninput="validatePassword()">
                <button type="button" class="toggle-password" onclick="togglePassword('password')">
                    <i class="far fa-eye"></i>
                </button>
            </div>

            <div class="password-input-group">
                <input type="password" id="confirmPassword" class="password-input" placeholder="Повторите пароль"
                       oninput="validatePassword()">
                <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword')">
                    <i class="far fa-eye"></i>
                </button>
            </div>

            <div class="requirements">
                <div class="requirement-item" id="req-length">
                    <span class="requirement-icon">•</span>
                    <span>Минимум 10 символов</span>
                </div>
                <div class="requirement-item" id="req-uppercase">
                    <span class="requirement-icon">•</span>
                    <span>Содержит большие латинские буквы (A-Z)</span>
                </div>
                <div class="requirement-item" id="req-digit">
                    <span class="requirement-icon">•</span>
                    <span>Содержит цифры (0-9)</span>
                </div>
                <div class="requirement-item" id="req-match">
                    <span class="requirement-icon">•</span>
                    <span>Пароли совпадают</span>
                </div>
            </div>

            <button id="saveBtn" class="save-button" disabled>
                Сохранить и войти
            </button>
        </div>

        <div id="resultMessage" class="resend-result"></div>
    </div>

    <script>
        const token = '@ViewBag.Token';
        const email = document.getElementById('userEmail').textContent;

        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = input.nextElementSibling.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        function validatePassword() {
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const saveBtn = document.getElementById('saveBtn');

            // Проверяем требования
            const hasMinLength = password.length >= 10;
            const hasUppercase = /[A-Z]/.test(password);
            const hasDigit = /\d/.test(password);
            const passwordsMatch = password === confirmPassword && password !== '';

            // Обновляем визуальные индикаторы
            updateRequirement('req-length', hasMinLength);
            updateRequirement('req-uppercase', hasUppercase);
            updateRequirement('req-digit', hasDigit);
            updateRequirement('req-match', passwordsMatch);

            // Активируем кнопку если все требования выполнены
            saveBtn.disabled = !(hasMinLength && hasUppercase && hasDigit && passwordsMatch);
        }

        function updateRequirement(elementId, isMet) {
            const element = document.getElementById(elementId);
            if (isMet) {
                element.classList.add('requirement-met');
                element.classList.remove('requirement-not-met');
                element.querySelector('.requirement-icon').textContent = '✓';
            } else {
                element.classList.add('requirement-not-met');
                element.classList.remove('requirement-met');
                element.querySelector('.requirement-icon').textContent = '•';
            }
        }

        document.getElementById('saveBtn').addEventListener('click', function () {
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const resultMessage = document.getElementById('resultMessage');
            const button = this;

            button.innerHTML = '⏳ Сохранение...';
            button.disabled = true;

            fetch('/Email/SetPassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    email: email,
                    password: password,
                    confirmPassword: confirmPassword,
                    token: token
                })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        resultMessage.innerHTML = `<div class="alert alert-success">✅ ${data.message}</div>`;
                        if (data.rememberToken && data.deviceId) {
                            localStorage.setItem('remember_token', data.rememberToken);
                            localStorage.setItem('device_id', data.deviceId);
                            localStorage.setItem('remember_email', email);
                        }
                        if (data.redirectUrl) {
                            setTimeout(() => {
                                window.location.href = data.redirectUrl;
                            }, 2000);
                        }
                    } else {
                        resultMessage.innerHTML = `<div class="alert alert-danger">❌ ${data.message}</div>`;
                        button.innerHTML = 'Сохранить и войти';
                        button.disabled = false;
                    }
                })
                .catch(error => {
                    resultMessage.innerHTML = '<div class="alert alert-danger">❌ Ошибка сети</div>';
                    button.innerHTML = 'Сохранить и войти';
                    button.disabled = false;
                });
        });

        // Автофокус на поле пароля
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('password').focus();
        });
    </script>
</body>
</html>